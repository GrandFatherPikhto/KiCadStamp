"each entry defines sheets: [<sheet names>] plus "
"clone_placements:/coordinate_placements: entries to instantiate per sheet"
msgstr ""

#: kicadstamp/config/sheet_templates.py:136
#, python-brace-format
msgid "sheet_template {name!r} must be a mapping"
msgstr ""

#: kicadstamp/config/sheet_templates.py:137
msgid "expected 'sheets:' plus clone_placements:/coordinate_placements: entries"
msgstr ""

#: kicadstamp/config/sheet_templates.py:141
#, python-brace-format
msgid "sheet_template {name!r} has unsupported key(s): {keys}"
msgstr ""

#: kicadstamp/config/sheet_templates.py:143
#, python-brace-format
msgid ""
"supported: {keys} — rules: is deliberately out of scope (sheet_templates "
"instantiates clone_placements/coordinate_placements only)"
msgstr ""
"поддерживаются: {keys} — rules: осознанно вне области применения "
"(sheet_templates инстанцирует только "
"clone_placements/coordinate_placements)"

#: kicadstamp/config/sheet_templates.py:149
#, python-brace-format
