msgstr ""

#: kicadstamp/config/sheet_templates.py:156
#, python-brace-format
msgid "sheet_template {name!r}: {section} entries must be mappings"
msgstr ""

#: kicadstamp/config/sheet_templates.py:158
#, python-brace-format
msgid "got {type}"
msgstr ""

#: kicadstamp/config/sheet_templates.py:174
#, python-brace-format
msgid ""
"sheet_template {name!r}: multi-sheet clone_placement needs a cluster: "
"(Cluster tag) to derive name:"
msgstr ""

#: kicadstamp/config/sheet_templates.py:199
#, python-brace-format
msgid ""
"Expanded {count} sheet_templates: blocks into "
"clone_placements/coordinate_placements"
msgstr ""

#: kicadstamp/config/tree_instances.py:291
#, python-brace-format
msgid ""
"tree_instance: template {template!r} net {ref!r} is not a "
"{old_sheet!r}-sheet net path"
msgstr ""
"tree_instance: сеть {ref!r} шаблона {template!r} — не путь сети листа "
"{old_sheet!r}"

#: kicadstamp/config/tree_instances.py:295
#, python-brace-format
msgid ""
"a net_trace node's net must be a board net path "
"'/{sheet}/{group}/{signal}' whose leading sheet segment equals the "
"template tree's anchor sheet — only that copper belongs to this template "
"and is rewritten per instance"
msgstr ""
"сеть узла net_trace должна быть путём сети платы "
"'/{sheet}/{group}/{signal}', ведущий сегмент которого равен sheet "
"role-якоря шаблонного дерева — только такая медь принадлежит этому "
"шаблону и переписывается под каждый экземпляр"

#: kicadstamp/config/tree_instances.py:456
#, python-brace-format
msgid ""
"tree_instance: template {template!r} mount node {ref!r} has no sheet in "
"its anchor"
msgstr ""
"tree_instance: у mount-узла {ref!r} шаблона {template!r} нет sheet в "
"привязке"

#: kicadstamp/config/tree_instances.py:459
msgid ""
"add (sheet ...) to this mount node's anchor so it can be parameterized "
"per instance — without a sheet the role is ambiguous across the "
"instances' sheets"
msgstr ""
"добавьте (sheet ...) в привязку этого mount-узла, чтобы её можно было "
"параметризовать по инстансам — без sheet роль неоднозначна между листами "
"инстансов"

#: kicadstamp/config/tree_instances.py:467
#, python-brace-format
msgid ""
"tree_instance {name!r}: mount node {ref!r} anchors to sheet {sheet!r}, "
"not the template's {old!r} — kept verbatim"
msgstr ""
"tree_instance {name!r}: mount-узел {ref!r} привязан к листу {sheet!r}, а "
"не к листу шаблона {old!r} — оставлено без изменений"

#: kicadstamp/config/tree_instances.py:518
#, python-brace-format
msgid ""
"tree_instance: template {template!r} component node {ref!r} addresses its"
" component by refdes"
msgstr ""
"tree_instance: узел-компонент {ref!r} шаблона {template!r} адресует "
"компонент по refdes"

#: kicadstamp/config/tree_instances.py:521
msgid ""
"a refdes names ONE physical component on the board, so it cannot be "
"instantiated per sheet — address the component by (role ...) (sheet ...) "
"instead, or take this node out of the template"
msgstr ""
"refdes называет ОДИН физический компонент на плате, поэтому его нельзя "
"размножить по листам — адресуйте компонент через (role ...) (sheet ...) "
"или уберите этот узел из шаблона"

#: kicadstamp/config/tree_instances.py:528
#, python-brace-format
msgid ""
"tree_instance: template {template!r} component node {ref!r} has no sheet "
"in its anchor"
msgstr ""
"tree_instance: в anchor узла-компонента {ref!r} шаблона {template!r} нет "
"листа"

#: kicadstamp/config/tree_instances.py:531
msgid ""
"add (sheet ...) to this component node's address so it can be "
"parameterized per instance — without a sheet the role is ambiguous across"
" the instances' sheets"
msgstr ""
"добавьте (sheet ...) в адрес этого узла-компонента, чтобы его можно было "
"параметризовать по инстансам — без листа роль неоднозначна между листами "
"инстансов"

#: kicadstamp/config/tree_instances.py:539
#, python-brace-format
msgid ""
"tree_instance {name!r}: component node {ref!r} addresses sheet {sheet!r},"
" not the template's {old!r} — kept verbatim"
msgstr ""
"tree_instance {name!r}: узел-компонент {ref!r} адресует лист {sheet!r}, а"
" не лист шаблона {old!r} — оставлено дословно"

#: kicadstamp/config/tree_instances.py:573
#, python-brace-format
msgid ""
"tree_instance {name!r}: template {template!r} pivot_ref {ref!r} names no "
"node of the template tree"
msgstr ""
"tree_instance {name!r}: pivot_ref {ref!r} шаблона {template!r} не "
"называет ни одного узла дерева-шаблона"

#: kicadstamp/config/tree_instances.py:576
msgid ""
"the tree's inner point (pivot-ref) must name a node of the same tree — "
"check the template's pivot-ref"
msgstr ""
"внутренняя точка дерева (pivot-ref) должна называть узел того же дерева —"
" проверьте pivot-ref шаблона"

#: kicadstamp/config/tree_instances.py:605
#, python-brace-format
msgid ""
"tree_instance {name!r}: template {template!r} self anchor ref {ref!r} "
"names no node of the template tree"
msgstr ""
"tree_instance {name!r}: ref self-якоря шаблона {template!r} ({ref!r}) не "
"называет ни одного узла дерева-шаблона"

#: kicadstamp/config/tree_instances.py:608
msgid ""
"the self anchor's (ref ...) must name a placement node of the same tree —"
" check the template's anchor"
msgstr ""
"(ref ...) self-якоря обязан называть placement-узел того же дерева — "
"проверьте якорь шаблона"

#: kicadstamp/config/tree_instances.py:688
#, python-brace-format
msgid "tree_instance: template {template!r} has a node without a ref"
msgstr "tree_instance: в шаблоне {template!r} есть узел без ref"

#: kicadstamp/config/tree_instances.py:690
msgid ""
"every template node needs a ref naming an entities: entry (placement) or "
"a net_traces: entry by its net (net_trace)"
msgstr ""
"каждый узел шаблона должен иметь ref, ссылающийся на запись entities: "
"(placement) или на запись net_traces: по имени сети (net_trace)"

#: kicadstamp/config/tree_instances.py:717
#, python-brace-format
msgid ""
"tree_instance: template {template!r} node {ref!r} has no matching "
"net_traces: record"
msgstr ""
"tree_instance: узел {ref!r} шаблона {template!r} не имеет соответствующей"
" записи net_traces:"

#: kicadstamp/config/tree_instances.py:720
msgid ""
"every net_trace node of a tree template must reference an existing "
"net_traces: entry by its name (name:, or the net: of a legacy record)"
msgstr ""
"каждый узел net_trace шаблона дерева должен ссылаться на существующую "
"запись net_traces: по её имени (name:, либо по net: старой записи)"

# ── Э3.2: a named (role, pad) net_trace record needs no sheet rewrite ──
#: kicadstamp/config/tree_instances.py:740
#, python-brace-format
msgid ""
"tree_instance {name!r}: net_trace record {record!r} is named ((role, "
"pad)-based), but its copper still carries literal net(s) at {items} — a "
"named record's nets are NOT rewritten by sheet; check how the record was "
"captured"
msgstr ""
"tree_instance {name!r}: запись net_trace {record!r} именованная (основана"
" на (role, pad)), но на её меди всё ещё есть буквальные сети ({items}) — "
"у именованной записи сети НЕ переписываются по листу; проверьте, как "
"запись была захвачена"

#: kicadstamp/config/tree_instances.py:753
#, python-brace-format
msgid ""
"tree_instance: template {template!r} net_trace node {ref!r} needs the "
"template's anchor sheet"
msgstr ""
"tree_instance: узлу net_trace {ref!r} шаблона {template!r} нужен sheet "
"role-якоря шаблона"

#: kicadstamp/config/tree_instances.py:756
msgid ""
"a net_trace node's net is rewritten by replacing its leading sheet "
"segment (a legacy record has no name: and carries literal net paths), so "
"the template tree's role anchor must carry a sheet (anchor.sheet) naming "
"the template's own sheet"
msgstr ""
"сеть узла net_trace переписывается заменой ведущего сегмента (листа) — у "
"старой записи нет name:, а на меди лежат буквальные имена сетей, — "
"поэтому role-якорь шаблонного дерева обязан нести sheet (anchor.sheet) с "
"именем собственного листа шаблона"

#: kicadstamp/config/tree_instances.py:798
#, python-brace-format
msgid ""
"tree_instance: template {template!r} has unsupported node kind {kind!r} "
"(ref {ref!r})"
msgstr ""
"tree_instance: шаблон {template!r} содержит неподдерживаемый kind узла "
"{kind!r} (ref {ref!r})"

#: kicadstamp/config/tree_instances.py:801
msgid ""
"v1 tree templates support only kind=placement (Entity) and kind=net_trace"
" nodes — chain/coordinate/clone/module nodes inside a template are not "
"instantiated yet"
msgstr ""
"шаблоны деревьев v1 поддерживают только узлы kind=placement (Entity) и "
"kind=net_trace — узлы chain/coordinate/clone/module внутри шаблона пока "
"не инстанцируются"

#: kicadstamp/config/tree_instances.py:807
#: kicadstamp/config/tree_instances.py:968
#, python-brace-format
msgid ""
"tree_instance: template {template!r} node {ref!r} has no matching "
"entities: record"
msgstr ""
"tree_instance: узел {ref!r} шаблона {template!r} не имеет соответствующей"
" записи entities:"

#: kicadstamp/config/tree_instances.py:809
msgid ""
"a placement node of a tree template must reference an existing entities: "
"entry by its name"
msgstr ""
"placement-узел шаблона дерева должен ссылаться на существующую запись "
"entities: по её имени"

#: kicadstamp/config/tree_instances.py:934
#, python-brace-format
msgid ""
"tree_instance: template {template!r} must be role-anchored OR self-"
"anchored (an explicit (self ...), or no (anchor ...) at all)"
msgstr ""
"tree_instance: шаблон {template!r} обязан быть role-якорным ИЛИ "
"self-якорным (явный (self ...) либо вообще без (anchor ...))"

#: kicadstamp/config/tree_instances.py:937
msgid ""
"either an (anchor (role ...)) template, or a self anchor — an explicit "
"(anchor (self [(ref \"...\")])) OR no (anchor ...) at all with exactly "
"one top-level placement node; origin/ref/point anchors are still not "
"parameterized by sheet"
msgstr ""
"либо шаблон с (anchor (role ...)), либо self-якорь — явный (anchor (self "
"[(ref \"...\")])) ИЛИ вообще без (anchor ...) ровно с одним top-level "
"placement-узлом; якоря origin/ref/point по-прежнему не параметризуются "
"листом"

#: kicadstamp/config/tree_instances.py:947
#, python-brace-format
msgid ""
"tree_instance: template {template!r} is self-anchored but names no "
"resolvable subject node"
msgstr ""
"tree_instance: шаблон {template!r} self-якорный, но не называет "
"разрешимого узла-субъекта"

#: kicadstamp/config/tree_instances.py:949
msgid ""
"a bare (self) needs EXACTLY ONE top-level placement node; with several, "
"name the subject explicitly: (anchor (self (ref \"...\")))"
msgstr ""
"«голому» (self) нужен РОВНО ОДИН top-level placement-узел; если их "
"несколько, назовите субъект явно: (anchor (self (ref \"...\")))"

#: kicadstamp/config/tree_instances.py:971
msgid ""
"the self-anchored template's subject node must reference an existing "
"entities: entry by its name"
msgstr ""
"узел-субъект self-якорного шаблона обязан ссылаться на существующую "
"запись entities: по имени"

#: kicadstamp/config/tree_instances.py:988
#, python-brace-format
msgid ""
"tree_instance {name!r}: template {template!r} declares its own place, but"
" the template's own sheet cannot be derived"
msgstr ""
"tree_instance {name!r}: шаблон {template!r} объявляет собственное место, "
"но собственный лист шаблона вывести нельзя"

#: kicadstamp/config/tree_instances.py:991
msgid ""
"the template has a mount node or a legacy (literal-net) net_trace node, "
"whose expansion needs the template's own sheet — add (sheet \"...\") to a"
" (role ...) anchor of the template, or an explicit sheet to the root "
"Entity of the template tree"
msgstr ""
"в шаблоне есть узел mount либо старый узел net_trace (с буквальной "
"сетью), для раскрытия которых нужен собственный лист шаблона — добавьте "
"(sheet \"...\") в якорь (role ...) шаблона либо явный sheet корневой "
"Entity дерева-шаблона"

#: kicadstamp/config/tree_instances.py:1044
#, python-brace-format
msgid ""
"tree_instance {name!r}: template {template!r} is composite ({count} "
"distinct clusters among its nodes: {clusters}) — cluster override "
"{cluster!r} is NOT applied to individual Entity copies (each keeps its "
"own template cluster); the tree's own role-anchor cluster is still "
"overridden as requested"
msgstr ""
"tree_instance {name!r}: шаблон {template!r} — составной ({count} "
"различных кластеров среди его узлов: {clusters}) — оверрайд cluster "
"{cluster!r} НЕ применяется к отдельным копиям Entity (каждая сохраняет "
"свой шаблонный кластер); собственный кластер role-якоря дерева всё равно "
"переопределяется как запрошено"

#: kicadstamp/config/tree_instances.py:1088
msgid "'tree_instances' must be a list of template/name/sheet declarations"
msgstr "'tree_instances' должна быть списком деклараций template/name/sheet"

#: kicadstamp/config/tree_instances.py:1090
#, python-brace-format
msgid ""
"got {type} — expected a list of declarations, each with "
"template:/name:/sheet: (e.g. template: dac_buf, name: ch1_dac_buf, sheet:"
" Channel_1)"
msgstr ""
"получено {type} — ожидался список деклараций, каждая с "
"template:/name:/sheet: (например: template: dac_buf, name: ch1_dac_buf, "
"sheet: Channel_1)"

#: kicadstamp/config/tree_instances.py:1115
#, python-brace-format
msgid "duplicate name(s) in tree_instances: {names}"
msgstr "дублирующиеся имена в tree_instances: {names}"

#: kicadstamp/config/tree_instances.py:1117
msgid ""
"every tree_instances: declaration needs a unique name — each one "
"materializes exactly one tree (plus its entity copies), so give the "
"second declaration its own name:, or drop it"
msgstr ""
"у каждой декларации tree_instances: должно быть уникальное name: — каждая"
" порождает ровно одно дерево (и копии его сущностей): дайте второй "
"декларации своё name: или уберите её"

#: kicadstamp/config/tree_instances.py:1146
#, python-brace-format
msgid "tree_instances: entry #{idx} must be a mapping"
msgstr "tree_instances: запись #{idx} должна быть словарём"

#: kicadstamp/config/tree_instances.py:1147
msgid "each entry is a dict with template:/name:/sheet:"
msgstr "каждая запись — словарь с полями template:/name:/sheet:"

#: kicadstamp/config/tree_instances.py:1156
#, python-brace-format
msgid "tree_instances: entry #{idx} missing required {field}:"
msgstr "tree_instances: записи #{idx} не хватает обязательного поля {field}:"

#: kicadstamp/config/tree_instances.py:1158
msgid ""
"every tree_instances: entry needs template:/name:/sheet: (non-empty "
"strings)"
msgstr ""
"каждой записи tree_instances: нужны template:/name:/sheet: (непустые "
"строки)"

#: kicadstamp/config/tree_instances.py:1163
#, python-brace-format
msgid "tree_instances: entry #{idx} has an empty cluster:"
msgstr "tree_instances: у записи #{idx} пустой cluster:"

#: kicadstamp/config/tree_instances.py:1178
#, python-brace-format
msgid "tree_instances: entry #{idx} has a non-mapping params:"
msgstr "tree_instances: у записи #{idx} params: не является словарём"

#: kicadstamp/config/tree_instances.py:1193
#, python-brace-format
msgid "tree_instances: entry #{idx} has a non-mapping anchor:"
msgstr "tree_instances: у записи #{idx} anchor: не является отображением:"

#: kicadstamp/config/tree_instances.py:1204
#, python-brace-format
msgid "tree_instances: entry #{idx} has a non-numeric rotation:"
msgstr "tree_instances: у записи #{idx} rotation: не является числом:"

#: kicadstamp/config/tree_instances.py:1219
#, python-brace-format
msgid "duplicate tree name from tree_instance {name!r}"
msgstr "дублирующееся имя дерева из tree_instance {name!r}"

#: kicadstamp/config/tree_instances.py:1221
msgid ""
"every tree in one config needs a unique name, and a tree with that name "
"already exists here — a trees: entry, the template itself, or an earlier "
"tree_instances: declaration — rename this instance, or rename/remove the "
"tree that already carries the name"
msgstr ""
"в одном конфиге у каждого дерева должно быть уникальное имя, а дерево с "
"таким именем уже есть — это либо запись trees:, либо сам шаблон, либо "
"более ранняя декларация tree_instances: — переименуйте этот инстанс или "
"переименуйте/удалите дерево, которое уже носит это имя"

#: kicadstamp/config/tree_instances.py:1229
#, python-brace-format
msgid "tree_instance {name!r}: template tree {template!r} not found"
msgstr "tree_instance {name!r}: дерево-шаблон {template!r} не найдено"

#: kicadstamp/config/tree_instances.py:1231
#, python-brace-format
msgid "known trees: {names}"
msgstr "известные деревья: {names}"

#: kicadstamp/config/tree_instances.py:1251
#, python-brace-format
msgid ""
