msgstr "среди {count} выделенных via нет ни одной на цепи {net!r}"

#: kicadstamp/template_selection.py:347
#, python-brace-format
msgid "--origin-by-via-net {net!r} is ambiguous"
msgstr "--origin-by-via-net {net!r} неоднозначен"

#: kicadstamp/template_selection.py:348
#, python-brace-format
msgid ""
"selection contains {count} vias on this net: {pos} — refine the selection"
" (keep only one such via) or use --origin-by-component-role instead"
msgstr ""
"в выделении {count} via на этой цепи: {pos} — уточните выделение "
"(оставьте только одну такую via) или используйте --origin-by-component-"
"role"

#: kicadstamp/template_selection.py:360
#, python-brace-format
msgid "--origin-by-component-role {role!r} not found in selection"
msgstr "--origin-by-component-role {role!r} не найден в выделении"

#: kicadstamp/template_selection.py:361
#, python-brace-format
msgid "among {count} selected components, none has role {role!r}"
msgstr "среди {count} выделенных компонентов нет ни одного с ролью {role!r}"

#: kicadstamp/template_selection.py:372
msgid "extract origin"
msgstr "начало отсчёта экстракта"

#: kicadstamp/template_selection.py:376
#, python-brace-format
msgid "--origin-by-component-role {role!r} is ambiguous"
msgstr "--origin-by-component-role {role!r} неоднозначен"

#: kicadstamp/template_selection.py:377
#, python-brace-format
msgid ""
"selection contains {count} components with role {role!r}: {refs} — set "
"the Origin Cluster and/or Sheet to pick one"
msgstr ""
"в выделении {count} компонентов с ролью {role!r}: {refs} — укажите "
"Cluster и/или Sheet в Origin, чтобы выбрать один"

#: kicadstamp/template_selection.py:387
#, python-brace-format
msgid "--origin-by-component-pad {pad!r} not found"
msgstr "--origin-by-component-pad {pad!r} не найден"

#: kicadstamp/template_selection.py:388
#, python-brace-format
msgid ""
"component with role {role!r} ({ref}) has no pad {pad!r} — pad numbers are"
" strings as in KiCad"
msgstr ""
"у компонента с ролью {role!r} ({ref}) нет площадки {pad!r} — номера падов"
" это строки, как в KiCad"

#: kicadstamp/tree_mount_convert.py:333
#, python-brace-format
msgid ""
"module node {ref!r}: references neither a trees: entry nor a "
"tree_instances: instance, so its pivot cannot be moved onto a tree — "
"check the module ref"
msgstr ""
"module-узел {ref!r}: не ссылается ни на запись trees:, ни на инстанс "
"tree_instances: — точку подвеса некуда перенести; проверьте ref "
"module-узла"

#: kicadstamp/tree_mount_convert.py:340
#, python-brace-format
msgid ""
"tree {name!r}: embedded with {count} DIFFERENT pivots — the inner point "
"is one per tree"
msgstr ""
"дерево {name!r}: встроено с {count} РАЗНЫМИ внутренними точками — "
"внутренняя точка одна на дерево"

#: kicadstamp/tree_mount_convert.py:361
#, python-brace-format
msgid ""
"module node {ref!r} (instance of tree {template!r}) is embedded with a "
"pivot ({pivot}) that differs from the template's own inner point — a "
"generated instance inherits its template's point, so set it on the "
"TEMPLATE tree instead"
msgstr ""
"module-узел {ref!r} (инстанс дерева {template!r}) встроен с точкой "
"подвеса ({pivot}), отличной от собственной внутренней точки шаблона — "
"сгенерированный инстанс наследует точку шаблона, поэтому задайте её на "
"ДЕРЕВЕ-шаблоне"

#: kicadstamp/tree_mount_convert.py:370
#, python-brace-format
msgid ""
"tree {name!r}: already carries its own pivot, which differs from the one "
"its embedding asks for"
msgstr ""
"дерево {name!r}: уже несёт свою внутреннюю точку, и она отличается от "
"той, которую просит его встраивание"

#: kicadstamp/tree_mount_convert.py:377
#, python-brace-format
msgid ""
"tree {name!r}: embedded with a NON-ZERO pivot ({pivot}) while it is also "
"a root tree — moving it onto the tree would shift its standalone "
"placement"
msgstr ""
"дерево {name!r}: встроено с НЕНУЛЕВОЙ внутренней точкой ({pivot}) и при "
"этом само является корневым деревом — перенос точки на дерево сдвинул бы "
"его самостоятельное размещение"

#: kicadstamp/tree_mount_convert.py:390
#, python-brace-format
msgid ""
"tree pivot conversion: {n} place(s) need a human decision — nothing was "
"written"
msgstr ""
"преобразование внутренних точек деревьев: {n} мест(а) требуют решения "
"человека — ничего не записано"

#: kicadstamp/tree_mount_convert.py:397
#, python-brace-format
msgid ""
"Tree conversion: {trees} tree(s) touched, {mounts} mount node(s) created,"
" {wrapped} node(s) wrapped, {pivots} inner point(s) moved onto a tree"
msgstr ""
"Преобразование деревьев: затронуто деревьев — {trees}, создано "
"mount-узлов — {mounts}, обёрнуто узлов — {wrapped}, перенесено внутренних"
" точек на дерево — {pivots}"

#: kicadstamp/tree_mount_convert.py:405
#, python-brace-format
msgid "  grouped {n} node(s) under a shared mount node"
msgstr "  объединено {n} узлов под общим mount-узлом"

#: kicadstamp/tree_mount_convert.py:408
#, python-brace-format
msgid ""
"  dropped {n} instance pivot(s) — a generated instance inherits its "
"template's inner point"
msgstr ""
"  снято {n} точек подвеса инстансов — сгенерированный инстанс наследует "
"внутреннюю точку шаблона"

#: kicadstamp/tree_mount_convert.py:412
#, python-brace-format
msgid "  tree {name!r}: {n} mount node(s)"
msgstr "  дерево {name!r}: {n} mount-узлов"

#: kicadstamp/tree_mount_convert.py:415
#, python-brace-format
msgid "  tree {name!r}: mount name {old!r} was taken — using {new!r}"
msgstr "  дерево {name!r}: имя mount-узла {old!r} занято — используем {new!r}"

#: kicadstamp/tree_mount_convert.py:419
msgid "Nothing to do: no own_anchor node found (already converted)"
msgstr "Нечего делать: узлов own_anchor не найдено (уже сконвертировано)"

#: kicadstamp/tree_mount_convert.py:463
msgid ""
"WARNING: this file has include: entries — only ITS OWN trees were "
"converted; convert each included file separately"
msgstr ""
"ВНИМАНИЕ: в файле есть include: — сконвертированы только ЕГО СОБСТВЕННЫЕ "
"деревья; каждый подключённый файл конвертируйте отдельно"

#: kicadstamp/tree_mount_convert.py:490
#, python-brace-format
msgid "convert-trees: wrote {path}"
msgstr "convert-trees: записан {path}"

#: kicadstamp/tree_position.py:170
#, python-brace-format
msgid "node {ref!r}: mount node has no anchor"
msgstr "узел {ref!r}: у mount-узла нет anchor"

#: kicadstamp/tree_position.py:173
#, python-brace-format
msgid ""
"tree {tree!r}: mount node {ref!r} is part of a cycle — its base depends "
"on itself through the nodes it anchors"
msgstr ""
"tree {tree!r}: mount-узел {ref!r} является частью цикла — его база "
"зависит от себя через узлы, которые он привязывает"

#: kicadstamp/tree_position.py:190
#, python-brace-format
msgid ""
"node {ref!r}: mount node needs a live board connection — its anchor role "
"{role!r} is not placed by this tree"
msgstr ""
"node {ref!r}: mount-узлу нужно живое подключение к плате — его роль "
"привязки {role!r} не размещается этим деревом"

#: kicadstamp/tree_position.py:270
#, python-brace-format
msgid ""
"node {ref!r}: mount node's anchor names pad {pad!r} — reading a pad's "
"shape needs a live board connection"
msgstr ""
"node {ref!r}: привязка mount-узла называет пад {pad!r} — чтение формы "
"пада требует живого подключения к плате"

#: kicadstamp/tree_position.py:419
#, python-brace-format
msgid "tree {tree_name!r}: pivot-ref {pivot_ref!r} not found in its own layout"
msgstr ""
"дерево {tree_name!r}: pivot-ref {pivot_ref!r} не найден в его собственной"
" раскладке"

#: kicadstamp/tree_position.py:888
#, python-brace-format
msgid ""
"self-anchor needs EXACTLY ONE top-level placement node on an Entity "
"(found {n} top-level node(s)) — name a node with (self (ref \"...\")) or "
"add an explicit (anchor ...) to this tree instead"
msgstr ""
"self-якорю нужен РОВНО ОДИН top-level placement-узел на Entity (найдено "
"{n} top-level узлов) — назовите узел через (self (ref \"...\")) либо "
"добавьте явный (anchor ...) этому дереву"

#: kicadstamp/placement/entity_placement.py:172 kicadstamp/tree_position.py:897
#, python-brace-format
msgid "tree {name!r} self-anchor"
msgstr "дерево {name!r} self-якорь"

#: kicadstamp/tree_position.py:1047
msgid ""
"a tree anchor's live base needs the plain configuration tree (cfg.trees) "
"— the rigid redraw cannot read it"
msgstr ""
"живой базе якоря дерева нужно плоское дерево конфигурации (cfg.trees) — "
"жёсткая перерисовка не может её прочитать"

#: kicadstamp/tree_position.py:1109
#, python-brace-format
msgid ""
"base {ref!r}: no rotation concept — assumed 0.0 for rigid-group "
"composition"
msgstr "база {ref!r}: нет понятия поворота — принято 0.0 для жёсткой композиции"

#: kicadstamp/tree_position.py:1192
#, python-brace-format
msgid ""
"tree redraw: node {name!r} has no resolvable live position ({error}) — "
"redrawn from its own record fields, not rigidly"
msgstr ""
"tree redraw: узел {name!r} без резолвной живой позиции ({error}) — "
"перерисовывается из собственных полей записи, не жёстко"

#: kicadstamp/tree_position.py:1315 kicadstamp/tree_position.py:1636
#, python-brace-format
msgid ""
"Node {ref!r} will be redrawn from the current position of {parent!r} (not"
" in selection); if {parent!r} moved, {ref!r} will land from the old point"
msgstr ""

#: kicadstamp/tree_position.py:1326
#, python-brace-format
msgid ""
"Node {ref!r} also has its own {field} — the regular (non-tree) "
"Apply/Redraw keeps using it; this tree redraw moves it TEMPORARILY, "
"without touching the record"
msgstr ""
"Узел {ref!r} также имеет собственный {field} — обычный (не-деревный) "
"Apply/Redraw продолжает им пользоваться; этот tree redraw двигает его "
"ВРЕМЕННО, не трогая запись"

#: kicadstamp/tree_position.py:1533
#, python-brace-format
msgid ""
"redraw conflict: tree {child!r} is embedded by active modules in several "
"trees ({parents}) — uncheck one of the module markers for this redraw"
msgstr ""
"конфликт перерисовки: дерево {child!r} встраивается активными модулями "
"сразу из нескольких деревьев ({parents}) — оставьте для этой перерисовки "
"только один модуль"

#: kicadstamp/tree_position.py:1553
#, python-brace-format
msgid ""
"Tree {name!r} is placed through a module in this redraw — nodes checked "
"in the tree itself are applied once via the module"
msgstr ""
"Дерево {name!r} в этой перерисовке размещается через модуль — узлы, "
"отмеченные в самом дереве, применяются один раз через модуль"

#: kicadstamp/tree_position.py:1614
msgid "cross-tree anchor cycle in curated redraw forest"
msgstr ""

#: kicadstamp/trees.py:277 kicadstamp/trees.py:2100
#, python-brace-format
msgid "node {ref!r}: invalid kind {kind!r} — expected one of {kinds}"
msgstr ""

#: kicadstamp/trees.py:291 kicadstamp/trees.py:2028
#, python-brace-format
msgid "node {ref!r}: {key} must be exactly two numbers"
msgstr ""

#: kicadstamp/trees.py:303 kicadstamp/trees.py:2157
#, python-brace-format
msgid "node {ref!r}: rotation must be a number"
msgstr ""

#: kicadstamp/trees.py:324
msgid "anchor: shift must be exactly two numbers"
msgstr "anchor: shift должен быть ровно двумя числами"

#: kicadstamp/trees.py:358
msgid ""
"anchor must specify exactly one of (origin), (ref \"...\"), (role "
"\"...\"), (point \"...\"), (self ...)"
msgstr ""
"якорь обязан задавать ровно одно из (origin), (ref \"...\"), (role "
"\"...\"), (point \"...\"), (self ...)"

#: kicadstamp/trees.py:362
msgid "anchor: (origin) and (external) are mutually exclusive"
msgstr "anchor: (origin) и (external) взаимоисключающие"

#: kicadstamp/trees.py:371
msgid "anchor: (external) is only valid with a (ref \"...\") anchor"
msgstr ""

#: kicadstamp/trees.py:385 kicadstamp/trees.py:388
msgid "anchor: only a (uuid \"…\") may follow a (point \"…\")"
msgstr "якорь: после (point \"…\") может стоять только (uuid \"…\")"

#: kicadstamp/trees.py:426
#, python-brace-format
msgid ""
"mount node {ref!r}: anchor supports only (role ...) — "
"origin/ref/point/external/self/shift are tree-anchor-only"
msgstr ""
"mount-узел {ref!r}: якорь поддерживает только (role ...) — "
"origin/ref/point/external/self/shift допустимы только у якоря дерева"

#: kicadstamp/trees.py:431
#, python-brace-format
msgid "mount node {ref!r}: anchor needs a (role ...)"
msgstr "mount-узел {ref!r}: anchor требует (role ...)"

#: kicadstamp/trees.py:463
#, python-brace-format
msgid ""
"component node {ref!r}: anchor supports only (ref ...) or (role ...) — "
"origin/point/external/self/shift are tree-anchor-only"
msgstr ""
"узел-компонент {ref!r}: anchor поддерживает только (ref ...) или (role "
"...) — origin/point/external/self/shift относятся только к якорю дерева"

#: kicadstamp/trees.py:469
#, python-brace-format
msgid ""
"component node {ref!r}: the address must be (ref ...) OR (role ...), not "
"both"
msgstr ""
"узел-компонент {ref!r}: адрес должен быть (ref ...) ИЛИ (role ...), но не"
" оба"

#: kicadstamp/trees.py:472
#, python-brace-format
msgid "component node {ref!r}: needs an address — (ref \"...\") or (role \"...\")"
msgstr "узел-компонент {ref!r}: нужен адрес — (ref \"...\") или (role \"...\")"

#: kicadstamp/trees.py:517
#, python-brace-format
msgid "{first} and {second}"
msgstr "{first} и {second}"

#: kicadstamp/trees.py:522
#, python-brace-format
msgid "tree {tree!r}: two component nodes carry the same address: {pairs}"
msgstr "дерево {tree!r}: два узла-компонента несут один и тот же адрес: {pairs}"

#: kicadstamp/trees.py:525
msgid ""
"a component is placed by exactly one node — give one of them its own "
"address"
msgstr ""
"компонент размещается ровно одним узлом — дайте одному из них собственный"
" адрес"

#: kicadstamp/trees.py:543
#, python-brace-format
msgid ""
"tree {tree!r}: mount node ref(s) {refs} are not unique — a mount node's "
"ref must identify exactly one node in the tree"
msgstr ""
"дерево {tree!r}: имена mount-узлов {refs} не уникальны — имя mount-узла "
"должно указывать ровно на один узел дерева"

#: kicadstamp/trees.py:545
#, python-brace-format
msgid ""
"tree {tree!r}: mount node ref(s) {refs} collide with a positioned node of"
" the same tree — mount refs must be distinct so a node can be named "
"unambiguously"
msgstr ""
"дерево {tree!r}: имена mount-узлов {refs} совпадают с позиционируемым "
"узлом того же дерева — имена mount-узлов должны быть различны, чтобы узел"
" можно было назвать однозначно"

#: kicadstamp/trees.py:550
#, python-brace-format
msgid ""
"tree {tree!r}: copper node ref(s) {refs} are not unique — a copper "
"container's ref must identify exactly one node in the tree"
msgstr ""
"дерево {tree!r}: ref узла(ов) меди {refs} не уникальны — ref контейнера "
"меди обязан указывать ровно на один узел дерева"

#: kicadstamp/trees.py:552
#, python-brace-format
msgid ""
"tree {tree!r}: copper node ref(s) {refs} collide with a positioned node "
"of the same tree — copper refs must be distinct so a node can be named "
"unambiguously"
msgstr ""
"дерево {tree!r}: ref узла(ов) меди {refs} совпадают с ref "
"позиционированного узла того же дерева — ref меди должны различаться, "
"чтобы узел можно было назвать однозначно"

#: kicadstamp/trees.py:557
#, python-brace-format
msgid ""
"tree {tree!r}: component node ref(s) {refs} are not unique — a component "
"node's ref is the name the redraw applies it by and must identify exactly"
" one node in the tree"
msgstr ""
"дерево {tree!r}: ref узлов-компонентов {refs} не уникальны — ref "
"узла-компонента это имя, по которому его применяет перерисовка, и он "
"должен указывать ровно один узел дерева"

#: kicadstamp/trees.py:560
#, python-brace-format
msgid ""
"tree {tree!r}: component node ref(s) {refs} collide with a positioned "
"node of the same tree — component node refs must be distinct so a node "
"can be named unambiguously"
msgstr ""
"дерево {tree!r}: ref узлов-компонентов {refs} совпадают с "
"позиционированным узлом того же дерева — ref узлов-компонентов должны "
"быть различны, чтобы узел назывался однозначно"

#: kicadstamp/trees.py:623
#, python-brace-format
msgid ""
"tree {tree!r}: {count} kind \"copper\" containers — a tree may have at "
"most one, it is the single home of that tree's inter-node copper nodes"
msgstr ""
"дерево {tree!r}: контейнеров вида \"copper\" — {count}; в дереве допустим"
" не более одного, он единственный дом для межузловых узлов меди этого "
"дерева"

#: kicadstamp/trees.py:628
msgid "keep one container and move the remaining copper nodes under it"
msgstr "оставь один контейнер, а остальные узлы меди перенеси внутрь него"

#: kicadstamp/trees.py:636
#, python-brace-format
msgid ""
"tree {tree!r}: copper container {container!r} has child(ren) that are not"
" copper: {refs}"
msgstr ""
"дерево {tree!r}: у контейнера меди {container!r} есть дети, которые не "
"являются медью: {refs}"

#: kicadstamp/trees.py:640
msgid ""
"a kind \"copper\" container may hold only kind \"net_trace\" (inter-node "
"copper) nodes"
msgstr ""
"контейнер вида \"copper\" может содержать только узлы вида \"net_trace\" "
"(межузловая медь)"

#: kicadstamp/trees.py:659
#, python-brace-format
msgid "tree {name!r}: self anchor ref {ref!r} names no node of this tree"
msgstr ""
"дерево {name!r}: ref self-якоря {ref!r} не называет ни одного узла этого "
"дерева"

#: kicadstamp/trees.py:662
#, python-brace-format
msgid ""
"tree {name!r}: self anchor ref {ref!r} is a kind {kind!r} node — a self "
"anchor must name a kind \"placement\" node of this tree"
msgstr ""
"дерево {name!r}: ref self-якоря {ref!r} — узел вида {kind!r}; self-якорь "
"обязан называть узел вида \"placement\" этого дерева"

#: kicadstamp/trees.py:817
#, python-brace-format
msgid ""
"tree {tree!r}: mount node {ref!r} is anchored to role {role!r}, which "
"this tree places in more than one cell ({candidates}) — narrow the anchor"
" with (sheet ...)/(cluster ...), or anchor to a role from outside the "
"tree"
msgstr ""
"tree {tree!r}: mount-узел {ref!r} привязан к роли {role!r}, которую это "
"дерево размещает более чем в одной ячейке ({candidates}) — сузьте "
"привязку через (sheet ...)/(cluster ...) или привяжитесь к роли вне "
"дерева"

#: kicadstamp/trees.py:826
#, python-brace-format
msgid ""
"tree {tree!r}: mount node {ref!r} is anchored to role {role!r} placed by "
"an EMBEDDED tree {child!r} — an internal mount across a module embedding "
"is not supported yet; anchor it to a role of a cell this tree places "
"directly, or to a role from outside the tree"
msgstr ""
"tree {tree!r}: mount-узел {ref!r} привязан к роли {role!r}, размещаемой "
"ВСТРОЕННЫМ деревом {child!r} — внутренний mount через встраивание модуля "
"пока не поддерживается; привяжите его к роли ячейки, которую это дерево "
"размещает напрямую, или к роли вне дерева"

#: kicadstamp/trees.py:835
#, python-brace-format
msgid ""
"tree {tree!r}: mount node {ref!r} is anchored to role {role!r} placed by "
"node {node_ref!r}, which sits under this very mount node — the base would"
" depend on itself (cycle); move the mount node above the placing node, or"
" anchor to a role from outside the tree"
msgstr ""
"tree {tree!r}: mount-узел {ref!r} привязан к роли {role!r}, размещаемой "
"узлом {node_ref!r}, который находится под этим самым mount-узлом — база "
"зависела бы от себя (цикл); перенесите mount-узел выше размещающего узла "
"или привяжитесь к роли вне дерева"

#: kicadstamp/trees.py:1228
#, python-brace-format
msgid ""
"the cell's mount A ({ax:.4f}, {ay:.4f}) does not sit on the anchor part's"
" own slot ({sx:.4f}, {sy:.4f}) — set the cell's anchor_role to {role!r} "
"(or its anchor_xy to ({sx:.4f}, {sy:.4f}))"
msgstr ""
"точка монтирования ячейки A ({ax:.4f}, {ay:.4f}) не совпадает со слотом "
"опорной детали ({sx:.4f}, {sy:.4f}) — задай ячейке anchor_role {role!r} "
"(или anchor_xy ({sx:.4f}, {sy:.4f}))"

#: kicadstamp/trees.py:1235
#, python-brace-format
msgid ""
"node {ref!r} stands at xy ({ox:.4f}, {oy:.4f}) instead of (0, 0), and "
"that offset repeats in every redraw — move the node to xy 0 (no "
"anchor_role on the cell can cure this)"
msgstr ""
"узел {ref!r} стоит в xy ({ox:.4f}, {oy:.4f}) вместо (0, 0), и это "
"смещение повторяется при каждой перерисовке — поставь узел в xy 0 "
"(anchor_role у ячейки тут не поможет)"

#: kicadstamp/trees.py:1242
#, python-brace-format
msgid ""
"the rotation already above node {ref!r} ({rho:.1f} deg — the tree's own "
"angle plus the nodes above it) plus the anchor part's slot angle "
"({slot:.1f} deg) turns it every redraw — set node {ref!r}'s rotation to "
"{suggested:.1f} deg (the sum must be 0 mod 360)"
msgstr ""
"поворот, уже накопленный над узлом {ref!r} ({rho:.1f} град — собственный "
"угол дерева и узлы выше), плюс собственный угол слота опорной детали "
"({slot:.1f} град) поворачивает её при каждой перерисовке — задай узлу "
"{ref!r} rotation {suggested:.1f} град (сумма должна быть 0 по модулю 360)"

#: kicadstamp/trees.py:1252
#, python-brace-format
msgid "or bind the tree to its own node: (anchor (self (ref \"{ref}\")))"
msgstr "или привяжи дерево к своему узлу: (anchor (self (ref \"{ref}\")))"

#: kicadstamp/trees.py:1264
#, python-brace-format
msgid ""
"node {ref!r} (cell {cell!r}) drifts by ({dx:.4f}, {dy:.4f}) mm and "
"{deg:.1f} deg per redraw (tree frame): {hints}"
msgstr ""
"узел {ref!r} (ячейка {cell!r}) уезжает на ({dx:.4f}, {dy:.4f}) мм и "
"{deg:.1f} град за перерисовку (в кадре дерева): {hints}"

#: kicadstamp/trees.py:1271
#, python-brace-format
msgid ""
"tree {tree!r}: the part its own anchor reads live ({role!r}) is placed by"
