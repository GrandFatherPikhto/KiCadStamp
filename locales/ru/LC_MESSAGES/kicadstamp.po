#: gui/board_overlay.py:180
#, python-brace-format
msgid ""
"Overlay layer {layer!r} is not enabled on this board — enable it in KiCad"
" first (or pick another overlay layer)."
msgstr ""
"Слой оверлея {layer!r} не включён на этой плате — сначала включите его в "
"KiCad (или выберите другой слой оверлея)."

#: gui/board_overlay.py:183
msgid ""
"the overlay is drawn as real KiCad graphics on a user layer; without the "
"layer enabled nothing can be drawn"
msgstr ""
"оверлей рисуется как настоящая графика KiCad на пользовательском слое; "
"без включённого слоя ничего нарисовать нельзя"

#: gui/board_overlay.py:320
#, python-brace-format
msgid ""
"sweep_layer: refusing to delete graphics on layer “{layer}” — only USER "
"layers can be swept"
msgstr ""
"sweep_layer: отказ удалять графику на слое «{layer}» — можно подметать "
"только пользовательские слои"

#: gui/board_overlay.py:322
msgid ""
"choose the dedicated overlay user layer (e.g. User.KiCadStamp); a sweep "
"on copper, silkscreen or Edge.Cuts would erase real board content"
msgstr ""
"выберите отдельный пользовательский слой оверлея (например "
"User.KiCadStamp); подметание меди, шелкографии или Edge.Cuts сотрёт "
"реальное содержимое платы"

#: gui/cell_identification.py:168 gui/docks/cell_anchor_view.py:660
#, python-brace-format
msgid ""
"nothing is selected on the board — select the components of ONE instance "
"of cell {cell!r}"
msgstr ""
"на плате ничего не выделено — выделите компоненты ОДНОГО экземпляра "
"ячейки {cell!r}"

#: gui/cell_identification.py:170 gui/docks/cell_anchor_view.py:663
msgid ""
"a spoke cell is identified by exactly ONE pair; an ordinary cluster can "
"be identified from any part of it"
msgstr ""
"спица идентифицируется ровно ОДНОЙ парой; обычный кластер можно "
"идентифицировать по любой его части"

#: gui/cell_identification.py:187
#, python-brace-format
msgid "filtered out {count} component(s) of other clusters"
msgstr "отсеяно {count} компонент(ов) других кластеров"

#: gui/cell_identification.py:195
#, python-brace-format
msgid ""
"no Role on {refs} — every selected component must be tagged with a Role "
"before the instance can be identified"
msgstr ""
"у {refs} нет поля Role — каждый выделенный компонент должен быть размечен"
" ролью, прежде чем экземпляр можно будет идентифицировать"

#: gui/cell_identification.py:198
msgid ""
"tag the components on the board — the “Refs” tab of this cell writes a "
"Role per component in one go — then identify again"
msgstr ""
"разметьте компоненты на плате — вкладка «Refs» этой ячейки записывает "
"роль каждому компоненту за один раз — и идентифицируйте заново"

#: gui/cell_identification.py:205 kicadstamp/spoke_extraction.py:121
#, python-brace-format
msgid ""
"the same Role is selected twice ({roles}) — select exactly one component "
"per Role"
msgstr ""
"одна и та же роль выделена дважды ({roles}) — выделите ровно один "
"компонент на роль"

#: gui/cell_identification.py:207
msgid ""
"two components of one Role say nothing about WHICH component is the "
"anchor of this instance"
msgstr ""
"два компонента одной роли не говорят, КАКОЙ именно компонент — якорь "
"этого экземпляра"

#: gui/cell_identification.py:213
#, python-brace-format
msgid ""
"the selection spans several clusters ({clusters}) — an instance belongs "
"to ONE cluster"
msgstr ""
"выделение попадает в несколько кластеров ({clusters}) — экземпляр "
"принадлежит ОДНОМУ кластеру"

#: gui/cell_identification.py:216
msgid "select the components of a single cluster instance, then identify again"
msgstr "выделите компоненты одного экземпляра кластера и идентифицируйте заново"

#: gui/cell_identification.py:221
#, python-brace-format
msgid ""
"no Cluster on {refs} — the instance cannot be told from another one of "
"the same cell"
msgstr ""
"у {refs} нет поля Cluster — экземпляр не отличить от другого экземпляра "
"той же ячейки"

#: gui/cell_identification.py:223
msgid ""
"set the Cluster on the board — the “Refs” tab of this cell writes one "
"cluster onto the whole table — then identify again"
msgstr ""
"проставьте кластер на плате — вкладка «Refs» этой ячейки записывает один "
"кластер на всю таблицу — и идентифицируйте заново"

#: gui/cell_identification.py:234
#, python-brace-format
msgid ""
"cluster {cluster!r} stands on several sheets ({sheets}) — the selection "
"mixes two instances"
msgstr ""
"кластер {cluster!r} стоит на нескольких листах ({sheets}) — в выделении "
"смешаны два экземпляра"

#: gui/cell_identification.py:237
msgid "select the components of ONE sheet instance, then identify again"
msgstr "выделите компоненты ОДНОГО листа-экземпляра и идентифицируйте заново"

#: gui/cell_identification.py:246
#, python-brace-format
msgid "{ref} has Role {role!r} which is not in cell {cell!r}"
msgstr "у {ref} роль {role!r}, которой нет в ячейке {cell!r}"

#: gui/cell_identification.py:248
#, python-brace-format
msgid "cell {cell!r} has roles: {roles}"
msgstr "у ячейки {cell!r} есть роли: {roles}"

#: gui/cell_identification.py:250 gui/docks/cascade.py:198
msgid "none"
msgstr "(нет)"

#: gui/cell_identification.py:251
msgid ""
"check the Role on the “Refs” tab of this cell — it lists this cell's own "
"roles"
msgstr ""
"проверьте роль на вкладке «Refs» этой ячейки — там перечислены "
"собственные роли ячейки"

#: gui/cell_identification.py:267
#, python-brace-format
msgid "a spoke needs exactly one component per cell role: missing {missing}"
msgstr ""
"спице нужен ровно один компонент на каждую роль ячейки: не хватает "
"{missing}"

#: gui/cell_identification.py:269
msgid ""
"select ONE pair of this cell on the board (the repeated roles make the "
"cluster ambiguous), then identify again"
msgstr ""
"выделите ОДНУ пару этой ячейки на плате (повторяющиеся роли делают "
"кластер неоднозначным) и идентифицируйте заново"

