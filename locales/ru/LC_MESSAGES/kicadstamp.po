msgstr "формат 3: дубль полного имени {name!r} в {section} — в {a} и {b}"

#: kicadstamp/config/format3.py:267
msgid ""
"names are unique within a section across the whole graph (Р43): rename "
"one of the two records"
msgstr ""
"имена уникальны внутри раздела по всему графу (Р43): переименуй одну из "
"двух записей"

#: kicadstamp/config/format3.py:275
#, python-brace-format
msgid "format 3: record {name!r} in {section} has no uuid"
msgstr "формат 3: запись {name!r} в {section} без UUID"

#: kicadstamp/config/format3.py:277
#, python-brace-format
msgid ""
"in {path}: every record of a format-3 file carries a UUID; add (uuid "
"\"…\") or lift the file with the converter"
msgstr ""
"в {path}: каждая запись файла формата 3 несёт UUID; добавь (uuid \"…\") "
"или подними файл конвертером"

#: kicadstamp/config/format3.py:287
#, python-brace-format
msgid "format 3: folder {path!r} in {section} has no uuid"
msgstr "формат 3: папка {path!r} в {section} без UUID"

#: kicadstamp/config/format3.py:289
#, python-brace-format
msgid "in {path}: a folder row carries a UUID"
msgstr "в {path}: строка папки несёт UUID"

#: kicadstamp/config/format3.py:296
#, python-brace-format
msgid ""
"format 3: folder {path!r} in {section} has uuid {a} in {fa} and {b} in "
"{fb}"
msgstr "формат 3: папка {path!r} в {section} имеет UUID {a} в {fa} и {b} в {fb}"

#: kicadstamp/config/format3.py:300
msgid ""
"one folder path in a section has ONE uuid across the whole graph (В39): "
"the seed is uuid5(NS, \"<section>|folder:<path>\")"
msgstr ""
"один путь папки в разделе имеет ОДИН UUID по всему графу (В39): семя — "
"uuid5(NS, \"<section>|folder:<path>\")"

#: kicadstamp/config/format3.py:308 kicadstamp/config/format3.py:317
#, python-brace-format
msgid "format 3: duplicate uuid {uuid} — {a} ({fa}) and {b} ({fb})"
msgstr "формат 3: дубль UUID {uuid} — {a} ({fa}) и {b} ({fb})"

#: kicadstamp/config/format3.py:311 kicadstamp/config/format3.py:319
msgid "a UUID must identify exactly one record or folder"
msgstr "UUID должен указывать ровно на одну запись или папку"

#: kicadstamp/config/format3.py:332
#, python-brace-format
msgid "format 3: {label} has no uuid"
msgstr "формат 3: у {label} нет uuid"

#: kicadstamp/config/format3.py:333
#, python-brace-format
msgid ""
"in {path}: every reference to a record carries the target's UUID (§0); "
"the name is only a hint. Add the sibling UUID or lift the file with the "
"converter"
msgstr ""
"в {path}: каждая ссылка на запись несёт UUID цели (§0); имя — лишь "
"подсказка. Добавь соседний UUID или подними файл конвертером"

#: kicadstamp/config/format3.py:338
#, python-brace-format
msgid "format 3: {label} references uuid {uuid}, which is not in {target}"
msgstr "формат 3: {label} ссылается на UUID {uuid}, которого нет в {target}"

#: kicadstamp/config/format3.py:340
#, python-brace-format
msgid "in {path}: a reference UUID must name an existing {target} record"
msgstr "в {path}: UUID ссылки должен указывать на существующую запись {target}"

#: kicadstamp/config/format3.py:343
#, python-brace-format
msgid "Format-3 checks passed: {files} files, {records} records"
msgstr "Проверки формата 3 пройдены: файлов {files}, записей {records}"

#: kicadstamp/config/format3.py:373
#, python-brace-format
msgid "Format-3 references normalized by UUID: {count}"
msgstr "Ссылок формата 3 нормализовано по UUID: {count}"

#: kicadstamp/config/format3.py:397
#, python-brace-format
msgid "format 3: duplicate uuid {uuid} after template expansion — {a} and {b}"
msgstr "формат 3: дубль UUID {uuid} после раскрытия шаблонов — {a} и {b}"

#: kicadstamp/config/format3.py:399
msgid ""
"a generated copy's computed UUID must be unique across the whole graph "
"(it is a function of the ORIGINAL record's uuid plus the instance "
"identity) — two records sharing one UUID would resolve every reference to"
" the first"
msgstr ""
"вычисляемый UUID сгенерированной копии обязан быть уникальным по всему "
"графу (он — функция UUID ОРИГИНАЛЬНОЙ записи и идентичности экземпляра) —"
" две записи с одним UUID свели бы каждую ссылку к первой"

#: kicadstamp/config/format3.py:432
#, python-brace-format
msgid "format 3: duplicate full name {name!r} in {section}"
msgstr "формат 3: дубль полного имени {name!r} в {section}"

#: kicadstamp/config/format3.py:434
#, python-brace-format
msgid ""
"in {path}: names are unique within a section across the whole graph (Р43)"
" — rename one of the two records"
msgstr ""
"в {path}: имена уникальны в разделе по всему графу (Р43) — переименуй "
"одну из двух записей"

#: kicadstamp/config/format3.py:440
#, python-brace-format
msgid "format 3: duplicate uuid {uuid} — {a!r} and {b!r}"
msgstr "формат 3: дубль UUID {uuid} — {a!r} и {b!r}"

#: kicadstamp/config/format3.py:442
msgid "a UUID must identify exactly one record"
msgstr "UUID обязан называть ровно одну запись"

#: kicadstamp/config/format3.py:562
msgid "format 3: cannot write — the active graph root is not set"
msgstr "формат 3: запись невозможна — активный корень графа не задан"

#: kicadstamp/config/format3.py:563
#, python-brace-format
msgid ""
"in {path}: a format-3 write resolves reference UUIDs against the project "
"graph; open the profile, or pass --config on the CLI"
msgstr ""
"в {path}: запись формата 3 разрешает UUID ссылок по графу проекта; открой"
" профиль или передай --config в CLI"

#: kicadstamp/config/format3.py:599
#, python-brace-format
msgid "format 3: {label} names no existing {target} record ({name!r})"
msgstr "формат 3: {label} называет несуществующую запись {target} ({name!r})"

#: kicadstamp/config/format3.py:603
#, python-brace-format
msgid ""
"in {path}: a new reference is resolved once, at write time, by the "
"target's exact full name"
msgstr ""
"в {path}: новая ссылка разрешается один раз, при записи, по точному "
"полному имени цели"

#: kicadstamp/config/format3.py:614
#, python-brace-format
msgid ""
"format 3: cannot write — {count} reference(s) point at a uuid that is "
"missing from the graph"
msgstr ""
"формат 3: запись невозможна — {count} ссылок указывают на UUID, которого "
"нет в графе"

#: kicadstamp/config/format3.py:616
#, python-brace-format
msgid "in {path}: {items}"
msgstr "в {path}: {items}"

#: kicadstamp/config/format3.py:617
msgid ""
"deleting a record leaves its references dangling — delete WITH cascade, "
"or fix the references first"
msgstr ""
"удаление записи оставляет её ссылки висячими — удаляй С каскадом или "
"сначала почини ссылки"

#: kicadstamp/config/format_version.py:108
#, python-brace-format
msgid "the config format number must be a positive whole number, got {value}"
msgstr ""
"номер формата конфига должен быть целым положительным числом, получено "
"{value}"

#: kicadstamp/config/format_version.py:110
#, python-brace-format
msgid ""
"in {path}: the number is a plain whole number of 1 or more (like (version"
" 2))"
msgstr "в {path}: число — целое, 1 или больше (например (version 2))"

#: kicadstamp/config/format_version.py:143
#, python-brace-format
msgid ""
"config {path} is written in format {found}; this version of KiCadStamp "
"understands the format up to {supported}"
msgstr ""
"файл {path} записан в формате {found}; эта версия KiCadStamp понимает "
"формат до {supported}"

#: kicadstamp/config/format_version.py:145
msgid ""
"update KiCadStamp: the file is not read on purpose, so that nothing this "
"version does not know about is lost. Once a newer KiCadStamp has lifted "
"the profile, do not open it with an older one"
msgstr ""
"обновите KiCadStamp: файл не читается намеренно, чтобы не потерять то, "
"чего эта версия не знает. Профиль, поднятый новой версией KiCadStamp, не "
"открывайте старой"

#: kicadstamp/config/format_version.py:181
#, python-brace-format
msgid ""
"the converter from format {from_version} to {to_version} cannot run here:"
" it needs {requirement}"
msgstr ""
"конвертер формата из {from_version} в {to_version} здесь работать не "
"может: ему нужно {requirement}"

#: kicadstamp/config/format_version.py:184
#, python-brace-format
msgid ""
"in {path}: this step needs {requirement}, which parsing the file alone "
"does not give — the file can only be lifted where that data exists. "
"Refusing loudly is on purpose: skipping the step would hand out content "
"of an older format as if it were current"
msgstr ""
"в {path}: этому шагу нужно {requirement}, а разбор файла этого не даёт — "
"файл можно поднять только там, где такие данные есть. Отказ громкий "
"намеренно: пропуск шага выдал бы содержимое старого формата за текущее"

#: kicadstamp/config/format_version.py:243
#, python-brace-format
msgid ""
"format 2->3: {section}[{index}] in {path} has no name — the converter "
"minted {name!r}"
msgstr ""
"формат 2->3: {section}[{index}] в {path} без имени — конвертер сочинил "
"{name!r}"

#: kicadstamp/config/format_version.py:291
#, python-brace-format
msgid ""
"the kind of tree node {ref!r} — without it the converter cannot tell "
"which section its ref points into"
msgstr ""
"вид узла дерева {ref!r} — без него конвертер не может сказать, в какой "
"раздел ведёт его ref"

#: kicadstamp/config/format_version.py:364
#, python-brace-format
msgid "no format converter from {from_version} to {to_version}"
msgstr "нет конвертера формата из {from_version} в {to_version}"

#: kicadstamp/config/format_version.py:366
msgid ""
"the converter chain has a hole — this is an internal error, not a problem"
" with the file"
msgstr "в цепочке конвертеров дыра — это внутренняя ошибка, а не проблема файла"

#: kicadstamp/config/includes.py:113
#, python-brace-format
msgid "include: invalid entry {entry!r} in {source!r}"
msgstr "include: недопустимая запись {entry!r} в {source!r}"

#: kicadstamp/config/includes.py:114
msgid ""
"each entry must be either a file path string, or a mapping {{path: <str>,"
" enabled: <bool>}}"
msgstr ""
"каждая запись должна быть либо строкой с путём к файлу, либо отображением"
" {{path: <str>, enabled: <bool>}}"

#: kicadstamp/config/includes.py:124 kicadstamp/config/includes.py:294
#, python-brace-format
msgid "{file!r}: top level must be a YAML mapping, got {type}"
msgstr "{file!r}: верхний уровень должен быть YAML-отображением, получено {type}"

#: kicadstamp/config/includes.py:126 kicadstamp/config/includes.py:296
msgid ""
"check for a stray/misplaced list (e.g. list items left without a wrapping"
" 'clone_placements:'/'rules:' key)"
msgstr ""
"проверьте на лишний/не на месте список (например, элементы списка "
"остались без оборачивающего ключа 'clone_placements:'/'rules:')"

#: kicadstamp/config/includes.py:134
#, python-brace-format
msgid "{file!r}: {section!r} must be a list, got {type}"
msgstr "{file!r}: {section!r} должен быть списком, получено {type}"

#: kicadstamp/config/includes.py:136
#, python-brace-format
msgid ""
"{section!r} entries are a YAML list ('- name: ...'); {dict_sections} are "
"mappings — check for a mixed-up section key"
msgstr ""
"записи {section!r} — это YAML-список ('- name: ...'); {dict_sections} — "
"это отображения — проверьте, не перепутан ли ключ раздела"

#: kicadstamp/config/includes.py:144
#, python-brace-format
msgid "{file!r}: {section!r} must be a mapping, got {type}"
msgstr "{file!r}: {section!r} должно быть отображением, получено {type}"

#: kicadstamp/config/includes.py:146
#, python-brace-format
msgid ""
"{section!r} entries are a YAML mapping ('key: {{...}}'); {list_sections} "
"are lists — check for a mixed-up section key"
msgstr ""
"записи {section!r} — это YAML-отображение ('key: {{...}}'); "
"{list_sections} — это списки — проверьте, не перепутан ли ключ раздела"

#: kicadstamp/config/includes.py:174
#, python-brace-format
msgid ""
"include: {file!r} has top-level key(s) not supported inside an included "
"file: {keys}"
msgstr ""
"include: {file!r} содержит ключи верхнего уровня, не поддерживаемые "
"внутри включаемого файла: {keys}"

#: kicadstamp/config/includes.py:176
#, python-brace-format
msgid ""
"include: only merges {list_sections} (lists) and {dict_sections} "
"(mappings) from an included file — anything else (e.g. layer:, "
"schematic_dir:, registry_path:) has no defined way to merge across "
"multiple included files and was previously silently dropped. Move {keys} "
"to the root config file instead"
msgstr ""
"include: сливает из включаемого файла только {list_sections} (списки) и "
"{dict_sections} (отображения) — для всего остального (например, layer:, "
"schematic_dir:, registry_path:) нет определённого способа слияния между "
"несколькими включаемыми файлами, и раньше это молча отбрасывалось. "
"Перенесите {keys} в корневой файл конфига"

#: kicadstamp/config/includes.py:198
#, python-brace-format
msgid "include: {file!r} disabled, skipped (not opened)"
msgstr "include: {file!r} отключён, пропущен (не открывался)"

#: kicadstamp/config/includes.py:205 kicadstamp/config/includes.py:317
#, python-brace-format
msgid "include: file {file!r} not found"
msgstr "include: файл {file!r} не найден"

#: kicadstamp/config/includes.py:206 kicadstamp/config/includes.py:318
#, python-brace-format
msgid ""
"expected at {path} (relative to {source!r}, not the current working "
"directory)"
msgstr ""
"ожидалось в {path} (относительно {source!r}, а не текущего рабочего "
"каталога)"

#: kicadstamp/config/includes.py:224 kicadstamp/config/includes.py:327
#, python-brace-format
msgid ""
"include: cycle detected — {file!r} is included from {source!r}, but is "
"already being resolved higher up the same include chain"
msgstr ""
"include: обнаружен цикл — {file!r} включается из {source!r}, но уже "
"разрешается выше по той же цепочке include:"

#: kicadstamp/config/includes.py:227 kicadstamp/config/includes.py:330
msgid ""
"the include: chain loops back on itself — remove one of the include: "
"entries that closes the loop"
msgstr ""
"цепочка include: замыкается сама на себя — уберите одну из записей "
"include:, замыкающую цикл"

#: kicadstamp/config/includes.py:231
#, python-brace-format
msgid ""
"include: {file!r} already resolved elsewhere in the tree (diamond) — "
"reusing, not re-merging"
msgstr ""
"include: {file!r} уже разрешён в другом месте дерева (ромб) — "
"переиспользую, не сливаю повторно"

#: kicadstamp/config/includes.py:246
#, python-brace-format
msgid "include: duplicate {section} key {key!r}"
msgstr "include: дублирующийся ключ {section} {key!r}"

#: kicadstamp/config/includes.py:247
#, python-brace-format
msgid "defined in {a!r} and again via include {b!r}"
msgstr "определён в {a!r} и повторно через include {b!r}"

#: kicadstamp/config/includes.py:252
#, python-brace-format
msgid "include: merged {file!r} into {source!r}"
msgstr "include: {file!r} слит в {source!r}"

#: kicadstamp/config/loader.py:100
#, python-brace-format
msgid "duplicate name(s) in {section}: {names}"
msgstr "дублирующиеся имена в {section}: {names}"

#: kicadstamp/config/loader.py:160
#, python-brace-format
msgid "Loading configuration from {path}"
msgstr "Загрузка конфигурации из {path}"

#: kicadstamp/config/loader.py:204
msgid "deprecated field 'target_ref' at root of config"
msgstr "устаревшее поле 'target_ref' в корне конфига"

#: kicadstamp/config/loader.py:205
msgid ""
"global target_ref has been removed (see discussion v117): each spoke rule"
" now has its own anchor – write anchor_ref: <ref> inside the rule in "
"rules; each thermal_via_arrays entry has its own anchor_ref field"
msgstr ""
"глобальный target_ref удалён (см. обсуждение v117): теперь у каждого "
"правила спицы свой якорь — пишите anchor_ref: <ref> внутри правила в "
"rules; у каждой записи thermal_via_arrays своё поле anchor_ref"

#: kicadstamp/config/loader.py:211
msgid "deprecated field 'side' at root of config"
msgstr "устаревшее поле 'side' в корне конфига"

#: kicadstamp/config/loader.py:212
msgid ""
"use layer: F.Cu or layer: B.Cu instead (layer for ManualSpoke rules; back"
" -> B.Cu)"
msgstr ""
"используйте layer: F.Cu или layer: B.Cu (слой для ManualSpoke правил; "
"back -> B.Cu)"

#: kicadstamp/config/loader.py:216
msgid "at root of config"
msgstr "в корне конфига"

#: kicadstamp/config/loader.py:220
msgid "deprecated field 'thermal_via_array' at root of config"
msgstr "устаревшее поле 'thermal_via_array' в корне конфига"

#: kicadstamp/config/loader.py:221
#, python-brace-format
msgid ""
"generalized to a list 2026-08-02 (a second IC needing thermal vias — "
"AD9707 — showed up): rename to 'thermal_via_arrays:' and wrap the single "
"block in a YAML list ('- name: ...'), e.g.\n"
"thermal_via_arrays:\n"
"  - name: {name}\n"
"    ..."
msgstr ""
"обобщено до списка 2026-08-02 (появилась вторая ИС, которой нужны "
"термо-via — AD9707): переименуйте в 'thermal_via_arrays:' и оберните "
"единственный блок в YAML-список ('- name: ...'), например\n"
"thermal_via_arrays:\n"
"  - name: {name}\n"
"    ..."

#: kicadstamp/config/loader.py:243
msgid ""
"every thermal_via_arrays entry needs a unique name: — --only cannot tell "
"same-named entries apart otherwise"
msgstr ""
"каждая запись thermal_via_arrays должна иметь уникальное name: — иначе "
"--only не сможет различить записи с одинаковым именем"

#: kicadstamp/config/loader.py:255
msgid ""
"every coordinate_placements entry needs a unique name (explicit, or the "
"default cluster/role pair) — --only cannot tell same-named entries apart "
"otherwise"
msgstr ""
"каждая запись coordinate_placements должна иметь уникальное name (явное "
"или пару cluster/role по умолчанию) — иначе --only не сможет различить "
"записи с одинаковым именем"

#: kicadstamp/config/loader.py:272
msgid ""
"every net_traces entry needs a unique name: — two bridges of one net are "
"legal, but they must carry different name: values (name: is the record's "
"--only identity, and it falls back to net: when absent); --only cannot "
"tell same-named entries apart otherwise"
msgstr ""
"каждая запись net_traces должна иметь уникальное name: — два моста одной "
"сети допустимы, но у них должны быть разные значения name: (name: — "
