#: kicadstamp/cli_main.py:146
msgid ""
"Ignore the current PCB editor selection for the whole run — role-based "
"ClonePlacements (role: without nets:/params:) and ambiguity narrowing "
"normally fall back to whatever is selected in KiCad; a stray leftover "
"selection then either fatals or silently changes the resolved candidate. "
"With this flag every such lookup behaves as if nothing were selected."
msgstr ""
"Игнорировать текущее выделение в редакторе PCB на весь прогон — ролевые "
"ClonePlacements (role: без nets:/params:) и сужение неоднозначности по "
"умолчанию опираются на выделенное в KiCad; случайно оставшееся выделение "
"тогда либо фаталит, либо молча меняет выбранного кандидата. С этим флагом"
" каждый такой поиск ведёт себя так, будто ничего не выделено."

#: kicadstamp/cli_main.py:152
msgid "Extra clearance for collision check in mm"
msgstr "Дополнительный зазор при проверке коллизий, мм"

#: kicadstamp/cli_main.py:154
msgid ""
"Process only "
"chains/clone_placements/thermal_via_arrays/coordinate_placements with "
"this identity (chain name if set, else its net; "
"clone_placement/thermal_via_arrays entry name; coordinate_placements "
"entry name, or its default cluster/role pair if name wasn't set). "
"Repeatable and/or comma-separated (--only a,b --only c). Everything else "
"is ignored in this run."
msgstr ""
"Обработать только chains/clone_placements/thermal_via_arrays с такой "
"идентичностью (имя цепи, если задано, иначе его цепь; имя записи "
"clone_placement/thermal_via_arrays). Флаг можно повторять и/или указывать"
" через запятую (--only a,b --only c). Всё остальное в этом прогоне "
"игнорируется."

#: kicadstamp/cli_main.py:161
msgid ""
"Process only "
"spokes/clone_placements/thermal_via_arrays/coordinate_placements entries "
"whose Cluster (anchor_cluster / spoke cluster / coordinate_placements' "
"own cluster) matches this path or prefix (segment-wise, e.g. 'Channel_0' "
"also matches 'Channel_0/DAC_OA'). Repeatable and/or comma-separated. "
"Combines with --only via AND (run apply twice for OR)."
msgstr ""
"Обработать только записи spokes/clone_placements/thermal_via_arrays, чей "
"Cluster (anchor_cluster / cluster спицы) совпадает с этим путём или его "
"префиксом (по сегментам: 'Channel_0' также подходит для "
"'Channel_0/DAC_OA'). Флаг можно повторять и/или указывать через запятую. "
"Сочетается с --only через И (для ИЛИ запустите apply дважды)."

#: kicadstamp/cli_main.py:168
msgid "Undo last operation"
msgstr "Откатить последнюю операцию"

#: kicadstamp/cli_main.py:172
msgid ""
"Directory with operation_*.json undo logs (default: logs/ next to the "
"current working directory)"
msgstr ""
"Каталог с undo-логами operation_*.json (по умолчанию: logs/ рядом с "
"текущим рабочим каталогом)"

#: kicadstamp/cli_main.py:175
msgid ""
"Config file to read operation_log_dir's default from (optional; "
"overridden by --operation-log-dir)"
msgstr ""
"Файл конфига, из которого берётся дефолт operation_log_dir "
"(необязательно; переопределяется --operation-log-dir)"

#: kicadstamp/cli_main.py:187
msgid ""
"Report duplicate vias/tracks on the live board (delete the extras only "
"with --apply)"
msgstr ""
"Сообщить о дублях переходных отверстий/дорожек на открытой плате (удалить"
" лишние копии — только с --apply)"

#: kicadstamp/cli_main.py:191
msgid ""
"Delete the extra copies. Deletion REQUIRES --config: every removed item "
"is written to that profile's actions.log, and a removal that cannot be "
"journaled is refused."
msgstr ""
"Удалить лишние копии. Удаление ТРЕБУЕТ --config: каждый удалённый элемент"
" пишется в actions.log этого профиля, а удаление, которое нельзя записать"
" в журнал, отклоняется."

#: kicadstamp/cli_main.py:196
msgid ""
"Profile config file. REQUIRED with --apply, and then it names ONLY the "
"profile whose actions.log records the removals — the adapter is always "
"bare (use_store=False), so this flag does NOT change which board is read "
"or which Role/Cluster values resolve."
msgstr ""
"Файл профиля. ТРЕБУЕТСЯ с --apply, и тогда он называет ТОЛЬКО профиль, в "
"чей actions.log попадают записи об удалении — адаптер всегда голый "
"(use_store=False), поэтому флаг НЕ меняет ни плату, ни то, какие значения"
" Role/Cluster разрешаются."

#: kicadstamp/cli_main.py:206
msgid "Snapshot a channel to s-expr (file‑based cloner, no IPC)"
msgstr "Снимок канала в s-expr (файловый клонер, без IPC)"

#: kicadstamp/cli_main.py:208 kicadstamp/cli_main.py:223
msgid "Path to .net file"
msgstr "Путь к .net-файлу"

#: kicadstamp/cli_main.py:209 kicadstamp/cli_main.py:224
msgid "Path to .kicad_pcb file"
msgstr "Путь к .kicad_pcb-файлу"

#: kicadstamp/cli_main.py:210
msgid "Channel name, e.g. Channel_0"
msgstr "Имя канала, например Channel_0"

#: kicadstamp/cli_main.py:211
msgid "s-expr snapshot file"
msgstr "YAML-файл снимка"

#: kicadstamp/cli_main.py:213
msgid "S-expr (.sexp) file with named profiles for clone-extract"
msgstr "S-expr-файл (.sexp) с именованными профилями для clone-extract"

#: kicadstamp/cli_main.py:215
msgid ""
"Take net/pcb/channel/output from profile NAME in --profiles file (cannot "
"combine with explicit flags)"
msgstr ""
"Взять net/pcb/channel/output из профиля NAME в файле --profiles (нельзя "
"сочетать с явными флагами)"

#: kicadstamp/cli_main.py:221
msgid ""
"Generate a ready clone_placements: block for a channel clone (file-based,"
" no IPC)"
msgstr ""
"Сгенерировать готовый блок clone_placements: для клонирования канала "
"(файлово, без IPC)"

#: kicadstamp/cli_main.py:225
msgid "Source channel, e.g. Channel_0"
msgstr "Исходный канал, например Channel_0"

#: kicadstamp/cli_main.py:226
msgid "Cell (template) name to clone"
msgstr "Имя ячейки (шаблона) для клонирования"

#: kicadstamp/cli_main.py:228
msgid "Cluster tag base (default: the target channel name)"
msgstr "Базовый тег Cluster (по умолчанию — имя целевого канала)"

#: kicadstamp/cli_main.py:230
msgid "Target channels, comma-separated (default: every other channel)"
msgstr "Целевые каналы через запятую (по умолчанию — все остальные)"

#: kicadstamp/cli_main.py:232
msgid "Absolute position in mm (default: the target channel's own bbox origin)"
msgstr "Абсолютная позиция в мм (по умолчанию — bbox-угол самого целевого канала)"

#: kicadstamp/cli_main.py:233
msgid "Anchor by Role field (survives re-annotation)"
msgstr "Якорь по полю Role (переживает реаннотацию)"

#: kicadstamp/cli_main.py:234
msgid "Narrow the anchor role by sheet"
msgstr "Сузить якорь по роли через sheet"

#: kicadstamp/cli_main.py:235
msgid "Output .sexp file to write the clone_placements: block to"
msgstr "Выходной .sexp-файл для записи блока clone_placements:"

#: kicadstamp/cli_main.py:247
msgid ""
"Profile config file — WITH it Role/Cluster resolve through this profile's"
" override store (our values win over the board; the profile's own "
"role_cluster_source switch still decides, default: registry). WITHOUT it "
"the values come from the BOARD, exactly as before."
msgstr ""
"Файл конфига профиля — С ним Role/Cluster резолвятся через хранилище "
"ЭТОГО профиля (наши значения главнее платы; рубильник role_cluster_source"
" самого профиля при этом сохраняет последнее слово, по умолчанию "
"registry). БЕЗ него значения берутся с ПЛАТЫ, ровно как раньше."

#: kicadstamp/cli_main.py:251
msgid "Extract spoke cell from current selection"
msgstr "Извлечь шаблон спицы из текущего выделения"

#: kicadstamp/cli_main.py:253
msgid "Cell name (key in cells:)"
msgstr "Имя шаблона (ключ в cells:)"

#: kicadstamp/cli_main.py:254 kicadstamp/cli_main.py:347
msgid "Output .sexp/JSON file"
msgstr "Выходной .sexp/JSON-файл"

#: kicadstamp/cli_main.py:256
msgid "S-expr (.sexp) file with named profiles for extract"
msgstr "S-expr-файл (.sexp) с именованными профилями для extract"

#: kicadstamp/cli_main.py:258
msgid ""
"Take name/output/param/net-template/origin-by-* from profile NAME in "
"--profiles file (cannot combine with explicit flags)"
msgstr ""
"Взять name/output/param/net-template/origin-by-* из профиля NAME в файле "
"--profiles (нельзя сочетать с явными флагами)"

#: kicadstamp/cli_main.py:264
msgid ""
"Parameter for --net-template round-trip verification (e.g. channel=1); "
"can be repeated; not written to the cell, only round-trip check. OPTIONAL"
" now — via/track nets resolve from roles (net_from_role) and channel "
"patterns are auto-discovered, so params are only needed when you still "
"override nets via --net-template"
msgstr ""
"Параметр для round-trip проверки --net-template (например, channel=1); "
"можно повторять; в шаблон не пишется, только round-trip проверка. ТЕПЕРЬ "
"ОПЦИОНАЛЬНО — цепи via/track разрешаются из ролей (net_from_role), а "
"паттерны каналов обнаруживаются автоматически, так что params нужны "
"только если вы по-прежнему переопределяете сети через --net-template"

#: kicadstamp/cli_main.py:270
#, python-brace-format
msgid ""
"Mapping real net -> pattern with {placeholder} (e.g. "
"'DAC1_DB1=DAC{channel}_DB1'); can be repeated; fills net_template for "
"roles and parametrizes via.net at extraction. OPTIONAL now — bridging "
"roles auto-derive net_template and channel patterns are auto-discovered; "
"kept as an explicit override"
msgstr ""
"Карта реальная цепь -> паттерн с {placeholder} (например, "
"'DAC1_DB1=DAC{channel}_DB1'); можно повторять; заполняет net_template "
"ролей и параметризует via.net при извлечении. ТЕПЕРЬ ОПЦИОНАЛЬНО — "
"bridging-роли авто-выводят net_template, а паттерны каналов "
"обнаруживаются автоматически; оставлено как явный override"

#: kicadstamp/cli_main.py:276
msgid ""
"For components with multiple nets from --net-template on pads "
"(ferrite/inductor/fuse between two rails) – override WHICH net is the "
"role's net_template (e.g. 'PI_FILTER_FB=+5V_DIRTY'). OPTIONAL now: "
"extract auto-derives a designated net_template for bridging roles; this "
"flag only changes the designated net. Fatal if the role does not actually"
" have that net on its pads, or if the literal is not registered in --net-"
"template/params."
msgstr ""
"Для компонентов с НЕСКОЛЬКИМИ цепями из --net-template на падах "
"(дроссель/феррит/предохранитель между двумя шинами) – переопределяет, "
"КАКАЯ цепь является net_template роли (например, "
"'PI_FILTER_FB=+5V_DIRTY'). ТЕПЕРЬ ОПЦИОНАЛЬНО: extract авто-выводит "
"главную (designated) net_template для bridging-ролей; этот флаг только "
"меняет выбранную сеть. Фатал, если у роли на самом деле нет такой цепи на"
" падах, или литерал не зарегистрирован в --net-template/params."

#: kicadstamp/cli_main.py:284
msgid ""
"Write this via/track net as null instead of its literal name (e.g. "
"'+3V3') — at apply time a ManualSpoke-placed cell's via/track with net: "
"null inherits the enclosing Chain's own net (spoke_layout.py's 'via.net "
"or rule_net'), so this makes the cell reusable across Chains on different"
" nets. Only needed for ManualSpoke-reused cells — net_from_role cells "
"need none of this. Can be repeated. Fatal if the same net is also in "
"--param/--net-template."
msgstr ""
"Записывать цепь этой via/track как null вместо её литерального имени "
"(например, '+3V3') — при применении via/track ячейки, размещённой "
"ManualSpoke, с net: null наследует цепь охватывающего Chain "
"(spoke_layout.py 'via.net or chain_net'), поэтому ячейка переиспользуется"
" между Chain'ами с разными цепями. Нужен только для ячеек, "
"переиспользуемых через ManualSpoke — ячейкам с net_from_role это не "
"нужно. Можно повторять. Фатал, если та же цепь есть и в --param/--net-"
"template."

#: kicadstamp/cli_main.py:292
msgid ""
"Take the current selection as tracks/vias as-is, without the pad-"
"connectivity filter (every selected track/via goes into the cell, no "
"'connected to a kept footprint's pad' check)"
msgstr ""
"Взять текущее выделение как треки/via как есть, без pad-connectivity "
"фильтра (каждый выделенный трек/via попадёт в ячейку, без проверки 'связи"
" с падом оставленного футпринта')"

#: kicadstamp/cli_main.py:297
msgid ""
"Template origin — position of via on this net (instead of bbox); fatal if"
" no such via in selection or more than one"
msgstr ""
"Начало координат шаблона — позиция via на этой цепи (вместо bbox); "
"фатально, если такой via нет в выделении или их несколько"

#: kicadstamp/cli_main.py:300
msgid ""
"Template origin — position of component with this role (instead of bbox);"
" fatal if role not found in selection"
msgstr ""
"Начало координат шаблона — позиция компонента с этой ролью (вместо bbox);"
" фатально, если роль не найдена в выделении"

#: kicadstamp/cli_main.py:303
msgid ""
"Refine --origin-by-component-role: origin is the position of the specific"
" pad of that component, not its centre. Fatal without --origin-by-"
"component-role."
msgstr ""
"Уточнение --origin-by-component-role: начало координат — позиция "
"конкретного пада этого компонента, а не его центр. Фатально без --origin-"
"by-component-role."

#: kicadstamp/cli_main.py:316
msgid ""
"Refine --origin-by-component-role: narrow the same-role candidates to "
"this Cluster (prefix match, as the role-anchor resolver uses). Fatal if "
"several candidates remain even after narrowing."
msgstr ""
"Уточнение --origin-by-component-role: сузить кандидатов с этой ролью до "
"данного Cluster (совпадение по префиксу, как в резолвере ролевого якоря)."
" Фатально, если после сужения осталось несколько кандидатов."

#: kicadstamp/cli_main.py:321
msgid ""
"Refine --origin-by-component-role: narrow the same-role candidates to "
"this schematic sheet (no-op without schematic sheet_names — the optional "
"--config lends extract the profile's override store, not its sheet map; "
"prefer --origin-by-component-cluster)."
msgstr ""
"Уточнение к --origin-by-component-role: сузить кандидатов с той же ролью "
"до этого листа схемы (no-op без schematic sheet_names — необязательный "
"--config даёт extract хранилище профиля, но НЕ его карту листов; "
"предпочтительнее --origin-by-component-cluster)."

#: kicadstamp/cli_main.py:329
msgid ""
"Capture one net's copper (tracks + vias) as a net_traces: record, "
"anchored to a Role-resolved footprint over the whole board"
msgstr ""
"Захват меди одной сети (дорожки + переходные отверстия) как записи "
"net_traces: с привязкой к футпринту, найденному по Role на всей плате"

#: kicadstamp/cli_main.py:334
msgid ""
"Network name to capture (e.g. DAC_DB0; local hierarchical nets keep their"
" full '/Channel_0/...' form)"
msgstr ""
"Имя сети для захвата (например DAC_DB0; локальные иерархические сети "
"сохраняют полную форму '/Channel_0/...')"

#: kicadstamp/cli_main.py:337
msgid ""
"Role field of the anchor footprint (resolved over the whole board, same "
"search Chain/ClonePlacement use)"
msgstr ""
"Поле Role якорного футпринта (ищется по всей плате, тот же поиск, что у "
"Chain/ClonePlacement)"

#: kicadstamp/cli_main.py:340
msgid ""
"Narrow the anchor_role search by sheet (needs schematic_dir in the target"
" config at apply time; extract-net itself has no config, so prefer "
"--anchor-cluster for disambiguation)"
msgstr ""
"Сузить поиск anchor_role по листу (требует schematic_dir в целевом "
"конфиге на этапе apply; сам extract-net не имеет конфига, поэтому для "
"снятия неоднозначности предпочитайте --anchor-cluster)"

#: kicadstamp/cli_main.py:344
msgid "Narrow the anchor_role search by Cluster field (prefix match)"
msgstr "Сузить поиск anchor_role по полю Cluster (совпадение по префиксу)"

#: kicadstamp/cli_main.py:346
msgid "Anchor point = this pad's centre instead of the footprint centre"
msgstr "Точка якоря = центр этого пада вместо центра футпринта"

#: kicadstamp/cli_main.py:354
msgid ""
"Copy a whole channel's placement (components + vias + tracks) from --src "
"to --dst via a live twin map (variant B)"
msgstr ""
"Копировать всю расстановку канала (компоненты + via + дорожки) с --src на"
" --dst через живую карту близнецов (вариант Б)"

#: kicadstamp/cli_main.py:359
msgid "Source channel name, e.g. Channel_0"
msgstr "Имя исходного канала, напр. Channel_0"

#: kicadstamp/cli_main.py:361
msgid ""
"Destination channel name, e.g. Channel_1; repeatable to copy to several "
"channels in one run"
msgstr ""
"Имя канала назначения, напр. Channel_1; повторяемый для копирования на "
"несколько каналов за один запуск"

#: kicadstamp/cli_main.py:365
msgid "Pivot component refdes on the source channel"
msgstr "Рефдес пивот-компонента на исходном канале"

#: kicadstamp/cli_main.py:367
msgid "Pivot by Role field on the source channel (survives re-annotation)"
msgstr "Пивот по полю Role на исходном канале (переживает переаннотацию)"

#: kicadstamp/cli_main.py:369
msgid "Anchor on this pad of the pivot instead of its centre"
msgstr "Якорь на этом паде пивота вместо его центра"

#: kicadstamp/cli_main.py:371
msgid "Extra shift added to the pivot's destination position"
msgstr "Дополнительный сдвиг, прибавляемый к позиции пивота на канале назначения"

#: kicadstamp/cli_main.py:373
msgid "Explicit destination anchor point (when the pivot twin is not placed yet)"
msgstr "Явная точка якоря назначения (если близнец пивота ещё не размещён)"

#: kicadstamp/cli_main.py:376
msgid "Points mode: source anchor point"
msgstr "Режим точек: точка якоря источника"

#: kicadstamp/cli_main.py:378
msgid "Points mode: destination anchor point"
msgstr "Режим точек: точка якоря назначения"

#: kicadstamp/cli_main.py:380
msgid "Rotation of the whole construction (degrees)"
msgstr "Поворот всей конструкции (градусы)"

#: kicadstamp/cli_main.py:382
msgid ""
"Mirror the whole construction (F.Cu <-> B.Cu swap; inner copper layers "
"keep their layer)"
msgstr ""
"Отразить всю конструкцию (F.Cu <-> B.Cu меняются местами; внутренние "
"медные слои остаются на своих)"

#: kicadstamp/cli_main.py:384
msgid "Also copy foreign (global-net) copper inside the source bbox"
msgstr ""
"Копировать и постороннюю медь (глобальные цепи) внутри bbox исходного "
"канала"

#: kicadstamp/cli_main.py:386
msgid "Only print the plan, do not write to the board"
msgstr "Только вывести план, не писать на плату"

#: kicadstamp/cli_main.py:396
msgid "Merge an include: project into one self-contained file"
msgstr "Слить проект с include: в один самодостаточный файл"

#: kicadstamp/cli_main.py:399
msgid "Root config file to flatten (the whole include: graph is resolved from it)"
msgstr "Корневой файл конфига для слияния (из него разрешается весь граф include:)"

#: kicadstamp/cli_main.py:402
msgid ""
"Output file. Default: overwrite the root file in place; an explicit path "
"writes a NEW file and leaves the root untouched"
msgstr ""
"Выходной файл. По умолчанию: перезапись корневого файла на месте; явный "
"путь пишет НОВЫЙ файл, а корневой не трогает"

#: kicadstamp/cli_main.py:406
msgid ""
"Print the consolidation plan (sections and target path) without writing "
"anything"
msgstr "Напечатать план консолидации (секции и целевой путь) без записи"

#: kicadstamp/cli_main.py:411
msgid "Rewrite trees: from the removed own_anchor grammar to mount nodes"
msgstr "Переписать trees: с удалённой грамматики own_anchor на mount-узлы"

#: kicadstamp/cli_main.py:414
msgid "Config file whose trees: section is converted"
msgstr "Файл конфига, секция trees: которого конвертируется"

#: kicadstamp/cli_main.py:416
msgid ""
"Output file. Default: overwrite --root in place; an explicit path writes "
"a NEW file and leaves the root untouched (recommended: keep a backup)"
msgstr ""
"Выходной файл. По умолчанию: перезаписать --root на месте; явный путь "
"пишет НОВЫЙ файл и не трогает root (рекомендуется сохранить копию)"

#: kicadstamp/cli_main.py:420
msgid "Print the conversion report without writing anything"
msgstr "Показать отчёт конвертации, ничего не записывая"

#: kicadstamp/cli_main.py:430
msgid ""
"Write this profile's stored Role/Cluster values onto the board or into "
"the schematic"
msgstr "Записать значения Role/Cluster из хранилища профиля на плату или в схему"

#: kicadstamp/cli_main.py:433
msgid ""
"Profile config file whose override store (overrides/<stem>.fields.json, "
"next to it) is written out. REQUIRED — the store belongs to a profile."
msgstr ""
"Файл конфига профиля, хранилище которого (overrides/<stem>.fields.json "
"рядом с ним) записывается наружу. ОБЯЗАТЕЛЕН — хранилище принадлежит "
"профилю."

#: kicadstamp/cli_main.py:438
msgid ""
"Destination: “board” writes the live board through KiCad (one commit, one"
" Ctrl+Z); “schematic” splices the .kicad_sch offline, which is an "
"operation KiCad must be closed for."
msgstr ""
"Назначение: «board» пишет живую плату через KiCad (один коммит, один "
"Ctrl+Z); «schematic» сплайсит .kicad_sch офлайн, а это операция, при "
"которой KiCad должен быть закрыт."

#: kicadstamp/cli_main.py:443
msgid ""
"Print the plan and write NOTHING — neither the board nor any file is "
"touched."
msgstr ""
"Печатать план и НИЧЕГО не записывать — ни плата, ни какой-либо файл не "
"трогаются."

#: kicadstamp/cli_main.py:446
msgid ""
"The .kicad_sch to splice for --to schematic. Default: the profile's own "
"root_sheet."
msgstr ""
".kicad_sch для сплайса при --to schematic. По умолчанию — собственный "
"root_sheet профиля."

#: kicadstamp/cli_main.py:449
msgid "IPC timeout in ms (--to board only)"
msgstr "Таймаут IPC в мс (только для --to board)"

#: kicadstamp/cli_main.py:454
msgid "Show the profile's override store (ref, field, value, who set it)"
msgstr "Показать хранилище профиля (ref, поле, значение, кем поставлено)"

#: kicadstamp/cli_main.py:456
msgid ""
"Profile config file whose override store (overrides/<stem>.fields.json, "
"next to it) is listed. REQUIRED — the store belongs to a profile."
msgstr ""
"Файл конфига профиля, хранилище которого (overrides/<stem>.fields.json "
"рядом с ним) выводится. ОБЯЗАТЕЛЕН — хранилище принадлежит профилю."

#: kicadstamp/cli_main.py:466
msgid ""
"Drop stored Role/Cluster values by component (the “never mind” of the "
"override store)"
msgstr ""
"Убрать сохранённые значения Role/Cluster по компонентам («передумал» для "
"хранилища)"

#: kicadstamp/cli_main.py:469
msgid ""
"Profile config file whose override store (overrides/<stem>.fields.json, "
