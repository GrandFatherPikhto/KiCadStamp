msgstr "anchor_pad без anchor_ref/anchor_role в clone_placement {name!r}"

#: kicadstamp/config/entries.py:566
#, python-brace-format
msgid ""
"anchor_pad={pad!r} is set but no anchor specified – use anchor_ref: IC1 "
"or anchor_role: SOME_ROLE"
msgstr ""
"anchor_pad={pad!r} задан, но якорь не указан – используйте anchor_ref: "
"IC1 или anchor_role: SOME_ROLE"

#: kicadstamp/config/entries.py:574
#, python-brace-format
msgid "no anchor and no absolute coordinates in clone_placement {name!r}"
msgstr "нет ни якоря, ни абсолютных координат в clone_placement {name!r}"

#: kicadstamp/config/entries.py:575

msgid ""
"either set xy: [x, y] (absolute point on board), or "
"anchor_ref/anchor_role (+ optionally anchor_pad), or anchor_point, for "
"anchor‑based placement"
msgstr "задайте либо xy: [x, y] (абсолютная точка на плате), либо anchor_ref/anchor_role (+ необязательно anchor_pad), либо anchor_point — для размещения на основе якоря"

#: kicadstamp/config/entries.py:582
#, python-brace-format
msgid "deprecated field 'side' in clone_placement {name!r}"
msgstr "устаревшее поле 'side' в clone_placement {name!r}"

#: kicadstamp/config/entries.py:583

msgid ""
"side is now set by an explicit pair: layer: F.Cu|B.Cu (where we place – "
"fact) + mirror: true (how we place – operation, only meaningful when the "
"layer changes relative to the cell)"
msgstr "сторона теперь задаётся явной парой: layer: F.Cu|B.Cu (куда кладём — факт) + mirror: true (как кладём — операция, имеет смысл только при смене слоя относительно шаблона)"

#: kicadstamp/config/entries.py:589
#, python-brace-format
msgid "deprecated fields 'origin_x_mm'/'origin_y_mm' in clone_placement {name!r}"
msgstr "устаревшие поля 'origin_x_mm'/'origin_y_mm' в clone_placement {name!r}"

#: kicadstamp/config/entries.py:590
#, python-brace-format
msgid "renamed to xy: [x, y] — write xy: [{x}, {y}] instead"
msgstr "переименовано в xy: [x, y] — пишите xy: [{x}, {y}]"

#: kicadstamp/config/entries.py:598
#, python-brace-format
msgid "xy must be a 2-element [x, y] list in clone_placement {name!r}"
msgstr "xy должен быть списком из 2 элементов [x, y] в clone_placement {name!r}"

#: kicadstamp/config/entries.py:609
#, python-brace-format
msgid "by_selection: true with non-empty nets in clone_placement {name!r}"
msgstr "by_selection: true вместе с непустым nets в clone_placement {name!r}"

#: kicadstamp/config/entries.py:610
msgid ""
"nets is an explicit role->net mapping for 'by nets' mode; in selection "
"mode roles are resolved by mouse selection, not by nets – nets is "
"meaningless here. Either remove nets, or remove by_selection: true"
msgstr ""
"nets — это явная карта роль->цепь для режима «по цепям»; в режиме «по "
"выделению» роли резолвятся мышкой, а не по цепям – nets здесь "
"бессмысленен. Либо уберите nets, либо уберите by_selection: true"

#: kicadstamp/config/entries.py:616
#, python-brace-format
msgid "in clone_placement {name!r}"
msgstr "в clone_placement {name!r}"

#: kicadstamp/config/entries.py:653

msgid "deprecated field 'target_ref' in thermal_via_arrays"
msgstr "устаревшее поле 'target_ref' в thermal_via_arrays"

#: kicadstamp/config/entries.py:654
msgid "renamed for consistency: use anchor_ref"
msgstr "переименовано для единообразия: используйте anchor_ref"

#: kicadstamp/config/entries.py:658

msgid "thermal_via_arrays entry without name"
msgstr "запись thermal_via_arrays без name"

#: kicadstamp/config/entries.py:659

msgid ""
"every thermal_via_arrays entry must have a name – used in --only "
"(kicadstamp_cli.py) for isolated runs, and to tell entries apart; write "
"name: <any understandable string>, e.g. name: fpga_thermal"
msgstr "каждая запись thermal_via_arrays должна иметь name — используется в --only (kicadstamp_cli.py) для изолированных прогонов и чтобы различать записи; пишите name: <понятная строка>, например name: fpga_thermal"

#: kicadstamp/config/entries.py:664

msgid "unknown fields in thermal_via_arrays entry {name!r}"
msgstr "неизвестные поля в записи thermal_via_arrays {name!r}"

#: kicadstamp/config/entries.py:669

msgid ""
"anchor_point together with anchor_ref/anchor_role in thermal_via_arrays "
"entry {name!r}"
msgstr "anchor_point вместе с anchor_ref/anchor_role в записи thermal_via_arrays {name!r}"

#: kicadstamp/config/includes.py:54
#, python-brace-format
msgid "include: invalid entry {entry!r} in {source!r}"
msgstr "include: недопустимая запись {entry!r} в {source!r}"

#: kicadstamp/config/includes.py:55
msgid ""
"each entry must be either a file path string, or a mapping {{path: <str>,"
" enabled: <bool>}}"
msgstr "каждая запись должна быть либо строкой с путём к файлу, либо отображением {{path: <str>, enabled: <bool>}}"

#: kicadstamp/config/includes.py:65 kicadstamp/config/includes.py:227
#, python-brace-format
msgid "{file!r}: top level must be a YAML mapping, got {type}"
msgstr "{file!r}: верхний уровень должен быть YAML-отображением, получено {type}"

#: kicadstamp/config/includes.py:67 kicadstamp/config/includes.py:229
msgid ""
"check for a stray/misplaced list (e.g. list items left without a wrapping"
" 'clone_placements:'/'rules:' key)"
msgstr "проверьте на лишний/не на месте список (например, элементы списка остались без оборачивающего ключа 'clone_placements:'/'rules:')"

#: kicadstamp/config/includes.py:75
#, python-brace-format
msgid "{file!r}: {section!r} must be a list, got {type}"
msgstr "{file!r}: {section!r} должен быть списком, получено {type}"

#: kicadstamp/config/includes.py:77
#, python-brace-format
msgid ""
"{section!r} entries are a YAML list ('- name: ...'); {dict_sections} are "
"mappings — check for a mixed-up section key"
msgstr "записи {section!r} — это YAML-список ('- name: ...'); {dict_sections} — это отображения — проверьте, не перепутан ли ключ раздела"

#: kicadstamp/config/includes.py:85
#, python-brace-format
msgid "{file!r}: {section!r} must be a mapping, got {type}"
msgstr "{file!r}: {section!r} должно быть отображением, получено {type}"

#: kicadstamp/config/includes.py:87
#, python-brace-format
msgid ""
"{section!r} entries are a YAML mapping ('key: {{...}}'); {list_sections} "
"are lists — check for a mixed-up section key"
msgstr "записи {section!r} — это YAML-отображение ('key: {{...}}'); {list_sections} — это списки — проверьте, не перепутан ли ключ раздела"

#: kicadstamp/config/includes.py:110
#, python-brace-format
msgid ""
"include: {file!r} has top-level key(s) not supported inside an included "
"file: {keys}"
msgstr "include: {file!r} содержит ключи верхнего уровня, не поддерживаемые внутри включаемого файла: {keys}"

#: kicadstamp/config/includes.py:112
msgid ""
"include: only merges {list_sections} (lists) and {dict_sections} "
"(mappings) from an included file — anything else (e.g. layer:, "
"schematic_dir:, registry_path:) has no defined way to merge across "
"multiple included files and was previously silently dropped. Move {keys} "
"to the root config file instead"
msgstr "include: сливает из включаемого файла только {list_sections} (списки) и {dict_sections} (отображения) — для всего остального (например, layer:, schematic_dir:, registry_path:) нет определённого способа слияния между несколькими включаемыми файлами, и раньше это молча отбрасывалось. Перенесите {keys} в корневой файл конфига"

#: kicadstamp/config/includes.py:134
#, python-brace-format
msgid "include: {file!r} disabled, skipped (not opened)"
msgstr "include: {file!r} отключён, пропущен (не открывался)"

#: kicadstamp/config/includes.py:140 kicadstamp/config/includes.py:249
#, python-brace-format
msgid "include: file {file!r} not found"
msgstr "include: файл {file!r} не найден"

#: kicadstamp/config/includes.py:141 kicadstamp/config/includes.py:250
#, python-brace-format
msgid ""
"expected at {path} (relative to {source!r}, not the current working "
"directory)"
msgstr "ожидалось в {path} (относительно {source!r}, а не текущего рабочего каталога)"

#: kicadstamp/config/includes.py:155 kicadstamp/config/includes.py:255
msgid ""
"include: cycle detected — {file!r} is included from {source!r}, but is "
"already being resolved higher up the same include chain"
msgstr "include: обнаружен цикл — {file!r} включается из {source!r}, но уже разрешается выше по той же цепочке include:"

#: kicadstamp/config/includes.py:158 kicadstamp/config/includes.py:258
msgid ""
"the include: chain loops back on itself — remove one of the include: "
"entries that closes the loop"
msgstr "цепочка include: замыкается сама на себя — уберите одну из записей include:, замыкающую цикл"

#: kicadstamp/config/includes.py:162
msgid ""
"include: {file!r} already resolved elsewhere in the tree (diamond) — "
"reusing, not re-merging"
msgstr "include: {file!r} уже разрешён в другом месте дерева (ромб) — переиспользую, не сливаю повторно"

#: kicadstamp/config/includes.py:178
#, python-brace-format
msgid "include: duplicate {section} key {key!r}"
msgstr "include: дублирующийся ключ {section} {key!r}"

#: kicadstamp/config/includes.py:179
#, python-brace-format
msgid "defined in {a!r} and again via include {b!r}"
msgstr "определён в {a!r} и повторно через include {b!r}"

#: kicadstamp/config/includes.py:184
#, python-brace-format
msgid "include: merged {file!r} into {source!r}"
msgstr "include: {file!r} слит в {source!r}"

