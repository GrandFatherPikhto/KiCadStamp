msgstr "точка ({x:.3f}, {y:.3f}) мм"

# anchor mount-point step (2026-09-05)
msgid "role {role!r} (the cell's anchor origin)"
msgstr "роль {role!r} (якорный origin ячейки)"

# anchor mount-point step (2026-09-05)
msgid "role {role!r} (the cell's anchor origin) is not a component of this cell"
msgstr "роль {role!r} (якорный origin ячейки) — не компонент этой ячейки"

# anchor mount-point step (2026-09-05)
msgid "role {role!r} (the cell's zero-offset origin)"
msgstr "роль {role!r} (нулевой origin ячейки)"

