msgstr "У каждого компонента уже есть {role!r} и {cluster!r}."

#: gui/fieldstool_window.py:733
msgid "Fields added"
msgstr "Поля добавлены"

#: gui/fieldstool_window.py:734
msgid ""
"{count} file(s) written. Reopen KiCad and run Update PCB from Schematic "
"(F8) to sync the new fields down to the board."
msgstr "Записано файлов: {count}. Переоткройте KiCad и выполните Update PCB from Schematic (F8), чтобы синхронизировать новые поля на плату."

#: gui/kicad_processes_dialog.py:31
