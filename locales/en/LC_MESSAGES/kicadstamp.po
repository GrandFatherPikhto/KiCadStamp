msgstr ""

#: kicadstamp_cli.py:107
msgid ""
"Process only rules/clone_placements/thermal_via_arrays with this identity"
" (rule name if set, else its net; clone_placement/thermal_via_arrays "
"entry name). Repeatable and/or comma-separated (--only a,b --only c). "
"Everything else is ignored in this run."
msgstr ""

#: kicadstamp_cli.py:112
msgid ""
"Process only spokes/clone_placements/thermal_via_arrays entries whose "
"Cluster (anchor_cluster / spoke cluster) matches this path or prefix "
"(segment-wise, e.g. 'Channel_0' also matches 'Channel_0/DAC_OA'). "
"Repeatable and/or comma-separated. Combines with --only via AND (run "
"apply twice for OR)."
msgstr ""

